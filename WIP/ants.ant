set start = left;
set size = 16;
set fps = 4;

ant main = 1 {
	A_ID_1 = on(0, 0, 0, 1);
	A_ID_2 = on(0, 1, 0, 1);
	DIE = on(1, 1, 1, 1);
}

ant letter_a = 2 {
	COL_1 = 1;
	COL_3 = 1;

	ROT_2 = or(
		on(0, 0, 1, 1),
		on(0, 1, 1, 0),
	);
	ROT_1 = or(
		on(0, 0, 0, 0),
		on(0, 1, 0, 0),
		on(0, 1, 0, 1),
		on(0, 1, 1, 1),
	);
	ROT_0 = or(
		on(0, 0, 0, 0),
		on(0, 1, 1, 0),
	);

	DIE = on(1, 0, 0, 1);
}

ant letter_n = 4 {
	COL_1 = 1;

	ROT_2 = or(
		on(0, 0, 1, 0),
		on(0, 1, 0, 0)
	);
	ROT_1 = or(
		on(0, 0, 0, 0),
		on(0, 0, 1, 1)
	);
	ROT_0 = on(0, 0, 0, 0);

	DIE = on(0, 1, 1, 0);
}
