set start = left;
set size = 16;
set fps = 4;

ant main = 1 {
	A1 = on(0, 0, 0, 1);
	A2 = on(0, 1, 0, 1);
	D = on(1, 1, 1, 1);
}

ant letter_a = 2 {
	T1 = 1;
	T3 = 1;

	R2 = or(
		on(0, 0, 1, 1),
		on(0, 1, 1, 0),
	);
	R1 = or(
		on(0, 0, 0, 0),
		on(0, 1, 0, 0),
		on(0, 1, 0, 1),
		on(0, 1, 1, 1),
	);
	R0 = or(
		on(0, 0, 0, 0),
		on(0, 1, 1, 0),
	);

	D = on(1, 0, 0, 1);
}

ant letter_n = 4 {
	T1 = 1;

	R2 = or(
		on(0, 0, 1, 0),
		on(0, 1, 0, 0)
	);
	R1 = or(
		on(0, 0, 0, 0),
		on(0, 0, 1, 1)
	);
	R0 = on(0, 0, 0, 0);

	D = on(0, 1, 1, 0);
}
