set border = cycle;
set start_dir = "S";
set keys = "wd";
set fps = 12;
set size = 32;
set start_tick = 0x100;
set speed = 2;

set layer_limit = 2;
set layer_filter = 0b10;
# set fg = layers;
set bg = id;

ant queen = 0 {
	SIG_0 = -MEM_1;
	SIG_1 = -CTR_0;

	HLT = -MEM_0;
	MEM_0 = INL;

	A_ID_1 = INL;
	A_ID_2 = and(-MEM_1, CTR_6);
	MEM_1 = or(MEM_1, CTR_6);
	A_ROT_0 = 1;
}

ant player_spawner = 2 {
	A_LYR = 1;
	(A_ID_1, A_ID_0) = cpy(1);
	DIE = CTR_3;
	A_ROT_1 = 1;
}

ant player_spawner2 = 3 {
	A_ID_3 = 1;
	DIE = CTR_3;
}

ant obstacle_spawner = 4 {
	A_LYR = 1;
	ROT_2 = RND_0;
	ROT_1 = RND_1;
	(A_ID_2, A_ID_0) = cpy(PRB_2);
	DIE = and(CTR_7, CTR_6);
}

ant obstacle = 5 { HLT = 1; }

ant player = 8 {
	HLT = or(+SIG_0, -SIG_1, +X_IN_1, -X_IN_0, SIG_2);
	ROT_1 = and(-SIG_0, +SIG_1, +X_IN_1);
	SIG_2 = N_ID_2;
}
