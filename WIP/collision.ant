set border = cycle;
set start_dir = 2;
set keys = "wd";
set fps = 12;
set size = 32;
set start_tick = 0x100;
set speed = 2;

set layers = 2;
set layer_filter = 0b10;
# set fg = layers;
set bg = id;

ant queen = 0 {
	S0 = -M1;
	S1 = -C0;

	H = -M0;
	M0 = B;

	A1 = B;
	A2 = and(-M1, C6);
	M1 = or(M1, C6);
	AR0 = 1;
}

ant player_spawner = 2 {
	AA = 1;
	(A1, A0) = cpy(1);
	Z = C3;
	AR1 = 1;
}

ant player_spawner2 = 3 {
	A3 = 1;
	Z = C3;
}

ant obstacle_spawner = 4 {
	AA = 1;
	R2 = N0;
	R1 = N1;
	(A2, A0) = cpy(N12);
	Z = and(C7, C6);
}

ant obstacle = 5 { H = 1; }

ant player = 8 {
	H =   or(+S0, -S1, +X1, -X0, S2);
	R1 = and(-S0, +S1, +X1);
	S2 = VA2;
}
