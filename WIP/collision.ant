set border = cycle;
set start_dir = "S";
set keys = "wd";
set fps = 12;
set size = 32;
set start_tick = 0x100;
set speed = 2;

set layer_limit = 2;
set layer_filter = 0b10;
# set fg = layers;
set bg = id;

ant queen = 0 {
	SIG0 = -MEM1;
	SIG1 = -CTR0;

	HLT = -MEM0;
	MEM0 = INL;

	A_ID1 = INL;
	A_ID2 = and(-MEM1, CTR6);
	MEM1 = or(MEM1, CTR6);
	A_ROT0 = 1;
}

ant player_spawner = 2 {
	A_LYR = 1;
	(A_ID1, A_ID0) = cpy(1);
	DIE = CTR3;
	A_ROT1 = 1;
}

ant player_spawner2 = 3 {
	A_ID3 = 1;
	DIE = CTR3;
}

ant obstacle_spawner = 4 {
	A_LYR = 1;
	ROT2 = RND0;
	ROT1 = RND1;
	(A_ID2, A_ID0) = cpy(PRB2);
	DIE = and(CTR7, CTR6);
}

ant obstacle = 5 { HLT = 1; }

ant player = 8 {
	HLT =   or(+SIG0, -SIG1, +X_IN1, -X_IN0, SIG2);
	ROT1 = and(-SIG0, +SIG1, +X_IN1);
	SIG2 = N_ID2;
}
