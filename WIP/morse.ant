set fps = 16;
set border = wrap;
set height = 8;
set width = 64;
set start = left;
set bg_filter = bin;

ant main = 1 {
	# spawn block on step 1 and cursor on step 3, then die
	A_ID1 = or(on(0, 1), on(1, 1));
	(A_ID0, DIE) = cpy(on(1, 1));
}

ant block = 2 { HLT = 1; }

fn on_unit = (t6, t5, t4, t3, t2) => out {
	out = and(
		eq(CTR6, t6),
		eq(CTR5, t5),
		eq(CTR4, t4),
		eq(CTR3, t3),
		eq(CTR2, t2),

		and(-CTR1, CTR0)
	);
}

ant cursor = 3 {
	A_ID2 = or(
		on_unit(0, 0, 0, 0, 0),
		on_unit(0, 0, 1, 0, 0),
		on_unit(0, 1, 0, 0, 1),
		on_unit(0, 1, 0, 1, 0),
		on_unit(0, 1, 0, 1, 1),
		on_unit(0, 1, 1, 1, 0),
		on_unit(1, 0, 1, 0, 0),
		0
	);

	A_ID3 = or(
		on_unit(0, 0, 0, 0, 1),
		on_unit(0, 0, 0, 1, 1),
		on_unit(0, 0, 1, 1, 0),
		on_unit(0, 1, 0, 0, 0),
		on_unit(0, 1, 1, 0, 1),
		on_unit(0, 1, 1, 1, 1),
		on_unit(1, 0, 0, 0, 0),
		on_unit(1, 0, 0, 1, 0),
		0
	);

	A_ID4 = or(
		on_unit(0, 0, 0, 1, 0),
		on_unit(0, 0, 1, 0, 1),
		on_unit(0, 0, 1, 1, 1),
		on_unit(0, 1, 1, 0, 0),
		on_unit(1, 0, 0, 0, 1),
		on_unit(1, 0, 0, 1, 1),
		on_unit(1, 0, 1, 0, 1),
		0
	);

	DIE = on_unit(1, 0, 1, 0, 1);
}

fn symbol {
	KLL = and(-MEM3, N_OBS); # kill target (if first target)
	ROT0 = or(INL, KLL); # flip on first tick and after killing target
	MEM3 = or(MEM3, KLL);
	DIE = CTR6;
}

ant dit = 4 {
	symbol();
	COL = KLL;
	HLT = MEM0;
	MEM0 = or(MEM0, KLL);
}

ant dah = 8 { 
	symbol();
	(idle, MEM1, MEM0) = add(MEM1, MEM0, 0, and(MEM3, -MEM4));
	MEM4 = or(MEM4, idle);
	COL = and(MEM3, -MEM4);
	HLT = MEM4;
}

ant space = 16 {
	dit();
	COL = 0;
}
