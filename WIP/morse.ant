set fps = 16;
set border = wrap;
set height = 8;
set width = 64;
set start = left;
set bg_filter = bin;

ant main = 1 {
	# spawn block on step 1 and cursor on step 3, then die
	A1 = or(on(0, 1), on(1, 1));
	(A0, Z) = cpy(on(1, 1));
}

ant block = 2 { H = 1; }

fn on_unit = (c6, c5, c4, c3, c2) => out {
	out = and(
		eq(C6, c6),
		eq(C5, c5),
		eq(C4, c4),
		eq(C3, c3),
		eq(C2, c2),

		and(-C1, C0)
	);
}

ant cursor = 3 {
	A2 = or(
		on_unit(0, 0, 0, 0, 0),
		on_unit(0, 0, 1, 0, 0),
		on_unit(0, 1, 0, 0, 1),
		on_unit(0, 1, 0, 1, 0),
		on_unit(0, 1, 0, 1, 1),
		on_unit(0, 1, 1, 1, 0),
		on_unit(1, 0, 1, 0, 0),
		0
	);

	A3 = or(
		on_unit(0, 0, 0, 0, 1),
		on_unit(0, 0, 0, 1, 1),
		on_unit(0, 0, 1, 1, 0),
		on_unit(0, 1, 0, 0, 0),
		on_unit(0, 1, 1, 0, 1),
		on_unit(0, 1, 1, 1, 1),
		on_unit(1, 0, 0, 0, 0),
		on_unit(1, 0, 0, 1, 0),
		0
	);

	A4 = or(
		on_unit(0, 0, 0, 1, 0),
		on_unit(0, 0, 1, 0, 1),
		on_unit(0, 0, 1, 1, 1),
		on_unit(0, 1, 1, 0, 0),
		on_unit(1, 0, 0, 0, 1),
		on_unit(1, 0, 0, 1, 1),
		on_unit(1, 0, 1, 0, 1),
		0
	);

	Z = on_unit(1, 0, 1, 0, 1);
}

fn symbol {
	K = and(-M3, V); # kill target (if first target)
	R0 = or(B, K); # flip on first tick and after killing target
	M3 = or(M3, K);
	Z = C6;
}

ant dit = 4 {
	() = symbol();
	T = K;
	H = M0;
	M0 = or(M0, K);
}

ant dah = 8 { 
	() = symbol();
	(idle, M1, M0) = add(M1, M0, 0, and(M3, -M4));
	M4 = or(M4, idle);
	T = and(M3, -M4);
	H = M4;
}

ant space = 16 {
	() = dit();
	T = 0;
}
