set fps = 16;
set border = wrap;
set height = 8;
set width = 64;
set start = left;
set bg_filter = bin;

ant main = 1 {
	# spawn block on step 1 and cursor on step 3, then die
	A_ID_1 = or(on(0, 1), on(1, 1));
	(A_ID_0, DIE) = cpy(on(1, 1));
}

ant block = 2 { HLT = 1; }

fn on_unit = (t6, t5, t4, t3, t2) => out {
	out = and(
		eq(CTR_6, t6),
		eq(CTR_5, t5),
		eq(CTR_4, t4),
		eq(CTR_3, t3),
		eq(CTR_2, t2),

		and(-CTR_1, CTR_0)
	);
}

ant cursor = 3 {
	A_ID_2 = or(
		on_unit(0, 0, 0, 0, 0),
		on_unit(0, 0, 1, 0, 0),
		on_unit(0, 1, 0, 0, 1),
		on_unit(0, 1, 0, 1, 0),
		on_unit(0, 1, 0, 1, 1),
		on_unit(0, 1, 1, 1, 0),
		on_unit(1, 0, 1, 0, 0),
		0
	);

	A_ID_3 = or(
		on_unit(0, 0, 0, 0, 1),
		on_unit(0, 0, 0, 1, 1),
		on_unit(0, 0, 1, 1, 0),
		on_unit(0, 1, 0, 0, 0),
		on_unit(0, 1, 1, 0, 1),
		on_unit(0, 1, 1, 1, 1),
		on_unit(1, 0, 0, 0, 0),
		on_unit(1, 0, 0, 1, 0),
		0
	);

	A_ID_4 = or(
		on_unit(0, 0, 0, 1, 0),
		on_unit(0, 0, 1, 0, 1),
		on_unit(0, 0, 1, 1, 1),
		on_unit(0, 1, 1, 0, 0),
		on_unit(1, 0, 0, 0, 1),
		on_unit(1, 0, 0, 1, 1),
		on_unit(1, 0, 1, 0, 1),
		0
	);

	DIE = on_unit(1, 0, 1, 0, 1);
}

fn symbol {
	KLL = and(-MEM_3, OBS); # kill target (if first target)
	ROT_0 = or(INL, KLL); # flip on first tick and after killing target
	MEM_3 = or(MEM_3, KLL);
	DIE = CTR_6;
}

ant dit = 4 {
	symbol();
	COL = KLL;
	HLT = MEM_0;
	MEM_0 = or(MEM_0, KLL);
}

ant dah = 8 { 
	symbol();
	(idle, MEM_1, MEM_0) = add(MEM_1, MEM_0, 0, and(MEM_3, -MEM_4));
	MEM_4 = or(MEM_4, idle);
	COL = and(MEM_3, -MEM_4);
	HLT = MEM_4;
}

ant space = 16 {
	dit();
	COL = 0;
}
