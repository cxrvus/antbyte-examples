set size = 19;
set fps = 12;
set border = die;

ant queen = 0 {
	A_ID_0 = 1;
	DIE = and(CTR_2, CTR_1, CTR_0);
	SIG = -DIE;
	ROT_1 = and(-DIE, CTR_0);
	(A_MEM_2, A_MEM_1, A_MEM_0) = fwd(CTR_2, CTR_1, CTR_0);
}

ant main = 1 {
	 (COL_2, COL_1, COL_0) = fwd(MEM_2, MEM_1, MEM_0);
	 HLT = SIG;
	 ROT_1 = -OBS;
}
