set fps = 6;
set width = 4;
set start = top_left;
set border = die;

set desc = "randomness through mere conflict resolution";

ant queen = 0 {
	left = and(-T1, -T0);
	right = and(+T1, -T0);
	A0 = or(left, right);
	(AR0, AM) = cpy(left);

	D = and(T2, -T1, T0);
	S = -D;
}

ant spawner = 1 {
	H = 1;
	AR1 = 1;
	AR0 = M;
	A1 = -S;
	AM = M;
}

ant value = 2 { C1 = M; }

