set fps = 6;
set width = 4;
set start = top_left;
set border = die;

set desc = "randomness through mere conflict resolution";

ant queen = 0 {
	left = and(-CTR_1, -CTR_0);
	right = and(+CTR_1, -CTR_0);
	A_ID_0 = or(left, right);
	(A_ROT_0, A_MEM) = cpy(left);

	DIE = and(CTR_2, -CTR_1, CTR_0);
	SIG = -DIE;
}

ant spawner = 1 {
	HLT = 1;
	A_ROT_1 = 1;
	A_ROT_0 = MEM;
	A_ID_1 = -SIG;
	A_MEM = MEM;
}

ant value = 2 { COL_1 = MEM; }

