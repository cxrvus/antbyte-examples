set fps = 6;
set width = 4;
set start = top_left;
set border = die;

set desc = "randomness through mere conflict resolution";

ant queen = 0 {
	left = and(-CTR1, -CTR0);
	right = and(+CTR1, -CTR0);
	A_ID0 = or(left, right);
	(A_ROT0, A_MEM) = cpy(left);

	DIE = and(CTR2, -CTR1, CTR0);
	SIG = -DIE;
}

ant spawner = 1 {
	HLT = 1;
	A_ROT1 = 1;
	A_ROT0 = MEM;
	A_ID1 = -SIG;
	A_MEM = MEM;
}

ant value = 2 { COL1 = MEM; }

