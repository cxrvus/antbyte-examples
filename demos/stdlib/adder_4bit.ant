set {
	fps = 8;
	border = die;
	start_pos = top; start_dir = "W";
	width = 3; height = 32;
	fg = tile; bg = id;
}

ant queen = 1 { (HLT, ROT2, A_ID2, A_ROT0) = cpy(1); (DIE, A_ID1, A_ID0) = fwd(CTR2, CTR1, CTR0); }

ant adder_spawner = 5 { (SLP0, -A_ID3, -DIE) = cpy(INL); }
ant adder = 8 { (COL4, COL3, COL2, COL1, COL0) = add(N_COL23, N_COL22, N_COL21, N_COL20,, N_COL63, N_COL62, N_COL61, N_COL60); }

fn rand { (COL3, COL2, COL1, COL0) = fwd_and(-INL, RND3, RND2, RND1, RND0); }
ant rhs = 4 { rand(); rot_32(0, INL); SLP1 = INL; }
ant lhs = 6 { rand(); rot_32(INL, 0); }
