set {
	fps = 8;
	border = die;
	start_pos = top; start_dir = "W";
	width = 3; height = 32;
	fg = tile; bg = id;
}

ant queen = 1 { (H, R2, A2, AR0) = cpy(1); (D, A1, A0) = fwd(T2, T1, T0); }

ant adder_spawner = 5 { (W0, -A3, -D) = cpy(B); }
ant adder = 8 { (C4, C3, C2, C1, C0) = add(VC23, VC22, VC21, VC20,, VC63, VC62, VC61, VC60); }

fn rand { (C3, C2, C1, C0) = fwd_and(-B, N3, N2, N1, N0); }
ant rhs = 4 { rand(); rot_32(0, B); W1 = B; }
ant lhs = 6 { rand(); rot_32(B, 0); }
