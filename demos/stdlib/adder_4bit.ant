set {
	fps = 8;
	border = die;
	start_pos = top; start_dir = 4;
	width = 3; height = 32;
	fg = tile; bg = id;
}

ant queen = 1 { (H, D0, A2, AD2) = cpy(1); (Z, A1, A0) = fwd(T2, T1, T0); }

ant adder_spawner = 5 { (W0, -A3, -Z) = cpy(J); }
ant adder = 8 { (C4, C3, C2, C1, C0) = add(VC23, VC22, VC21, VC20,, VC63, VC62, VC61, VC60); }

fn rand { (C3, C2, C1, C0) = fwd_and(-J, R3, R2, R1, R0); }
ant rhs = 4 { () = rand(); () = rotd(0, J); W1 = J; }
ant lhs = 6 { () = rand(); () = rotd(J, 0); }
