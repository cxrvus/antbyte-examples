set size = 16;
set start = top_left;
set bg_filter = bin;
set border = die;
set speed = 4;

ant main = 1 {
	COL1 = 1;

	ROT1 = or(
		and(+CTR3, +CTR2, +CTR1, +CTR0),
		and(-CTR3, -CTR2, -CTR1, -CTR0, -INL)
	);

	ROT0 = or(
		and(+CTR4, +CTR3, +CTR2, +CTR1, +CTR0),
		and(-CTR4, -CTR3, -CTR2, -CTR1, -CTR0, -INL)
	);
}
