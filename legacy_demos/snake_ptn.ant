set size = 16;
set start = top_left;
set bg_filter = bin;
set border = die;
set speed = 4;

ant main = 1 {
	COL_1 = 1;

	ROT_1 = or(
		and(+CTR_3, +CTR_2, +CTR_1, +CTR_0),
		and(-CTR_3, -CTR_2, -CTR_1, -CTR_0, -INL)
	);

	ROT_0 = or(
		and(+CTR_4, +CTR_3, +CTR_2, +CTR_1, +CTR_0),
		and(-CTR_4, -CTR_3, -CTR_2, -CTR_1, -CTR_0, -INL)
	);
}
