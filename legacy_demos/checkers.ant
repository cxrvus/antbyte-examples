set height = 8;
set width = 32;
set start = top_left;
set speed = 8;
set bg_filter = bin;
set border = obs;
set start_dir = 2;

ant main = 1 {
	T0 = -C0;

	# M0: V in previous tick
	# M1: last rotation
	R1 = or(M0, V);
	R0 = and(R1, -M1);

	# toggle: toggle last rotation
	toggle = and(M0, -V);
	M1 = xor(M1, toggle);

	M0 = and(-M0, V);

	D = VT0;
}
