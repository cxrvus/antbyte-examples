cfg {
	height = 8;
	width = 32;
	start = top_left;
	speed = 8;
	bg_filter = bin;
	border = obs;
	start_dir = 2;
}

ant main = 1 {
	COL_0 = -CTR_0;

	# MEM_0: OBS in previous tick
	# MEM_1: last rotation
	ROT_1 = or(MEM_0, OBS);
	ROT_0 = and(ROT_1, -MEM_1);

	# toggle: toggle last rotation
	toggle = and(MEM_0, -OBS);
	MEM_1 = xor(MEM_1, toggle);

	MEM_0 = and(-MEM_0, OBS);

	DIE = N_COL_0;
}
