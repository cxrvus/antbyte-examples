set height = 8;
set width = 32;
set start = top_left;
set speed = 8;
set bg_filter = bin;
set border = obs;
set start_dir = 2;

ant main = 1 {
	COL_0 = -CTR_0;

	# MEM_0: OBS in previous tick
	# MEM_1: last rotation
	ROT_1 = or(MEM_0, OBS);
	ROT_0 = and(ROT_1, -MEM_1);

	# toggle: toggle last rotation
	toggle = and(MEM_0, -OBS);
	MEM_1 = xor(MEM_1, toggle);

	MEM_0 = and(-MEM_0, OBS);

	DIE = N_COL_0;
}
