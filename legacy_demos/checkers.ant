set height = 8;
set width = 32;
set start = top_left;
set speed = 8;
set bg_filter = bin;
set border = obs;
set start_dir = "S";

ant main = 1 {
	COL0 = -CTR0;

	# MEM0: OBS in previous tick
	# MEM1: last rotation
	ROT1 = or(MEM0, OBS);
	ROT0 = and(ROT1, -MEM1);

	# toggle: toggle last rotation
	toggle = and(MEM0, -OBS);
	MEM1 = xor(MEM1, toggle);

	MEM0 = and(-MEM0, OBS);

	DIE = N_COL0;
}
