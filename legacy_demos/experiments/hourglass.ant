set size = 128;
set start = top_left;
set speed = 128;
set fps = 32;
set border = wrap;
set bg_filter = bin;

fn dir_change = (mem, clock) => (mem_out, dir) {
	dir = xor(mem, clock);
	mem_out = clock;
}

ant main = 1 {
	CLR = 1;
	COL_0 = -COL_0;

	(MEM_2, ROT_1) = dir_change(MEM_2, CTR_2);
	(MEM_3, ROT_0) = dir_change(MEM_3, CTR_3);
	(MEM_7, ROT_2) = dir_change(MEM_7, CTR_7);
}
