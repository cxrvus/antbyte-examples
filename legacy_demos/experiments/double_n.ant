set bg_filter = bin;
set start = top_left;
set height = 7;	
set width = 9;	

ant main = 1 {
	COL1 = 1;
	DIE = on(1, 0, 0, 0, 1, 1);

	turn45 = or(
		on(0, 0, 0, 0, 1, 0),
		on(0, 1, 0, 1, 0, 1)
	);

	turn90 = or(
		on(0, 0, 1, 0, 1, 0),
		on(0, 0, 1, 1, 0, 0),
		on(0, 1, 0, 0, 1, 0),
		on(0, 1, 1, 0, 1, 1),
		on(0, 1, 1, 1, 0, 1)
	);

	turn295 = or(
		on(0, 0, 0, 1, 1, 0),
		on(0, 1, 1, 0, 0, 0)
	);

	ROT2 = or(turn45, turn295);
	ROT1 = turn90;
	ROT0 = turn295;
}
