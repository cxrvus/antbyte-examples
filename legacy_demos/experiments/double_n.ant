cfg {
	bg_filter = bin;
	start = top_left;
	height = 7;	
	width = 9;	
}

ant main = 1 {
	COL_1 = 1;
	DIE = on(1, 0, 0, 0, 1, 1);

	turn45 = or(
		on(0, 0, 0, 0, 1, 0),
		on(0, 1, 0, 1, 0, 1)
	);

	turn90 = or(
		on(0, 0, 1, 0, 1, 0),
		on(0, 0, 1, 1, 0, 0),
		on(0, 1, 0, 0, 1, 0),
		on(0, 1, 1, 0, 1, 1),
		on(0, 1, 1, 1, 0, 1)
	);

	turn295 = or(
		on(0, 0, 0, 1, 1, 0),
		on(0, 1, 1, 0, 0, 0)
	);

	ROT_2 = or(turn45, turn295);
	ROT_1 = turn90;
	ROT_0 = turn295;
}
