set size = 8;
set start = top_left;
set border = wrap;
set speed = 64;
set fps = 24;
set fg = none;

fn main = (y2, y1, y0, x2, x1, x0) => () {
	black = or(
		and(
			or(
				pair_eq(y2, y1, y0, 0, 0, 1),
				pair_eq(y2, y1, y0, 0, 1, 0)
			),
			or(
				pair_eq(x2, x1, x0, 0, 0, 1),
				pair_eq(x2, x1, x0, 0, 1, 0),
				pair_eq(x2, x1, x0, 1, 0, 1),
				pair_eq(x2, x1, x0, 1, 1, 0)
			)
		),

		and(
			pair_eq(y2, y1, y0, 0, 1, 1),
			or(
				pair_eq(x2, x1, x0, 0, 1, 1),
				pair_eq(x2, x1, x0, 1, 0, 0)
			)
		),

		and(
			or(
				pair_eq(y2, y1, y0, 1, 0, 0),
				pair_eq(y2, y1, y0, 1, 0, 1)
			),
			or(
				pair_eq(x2, x1, x0, 0, 1, 0),
				pair_eq(x2, x1, x0, 0, 1, 1),
				pair_eq(x2, x1, x0, 1, 0, 0),
				pair_eq(x2, x1, x0, 1, 0, 1)
			)
		),

		and(
			pair_eq(y2, y1, y0, 1, 1, 0),
			or(
				pair_eq(x2, x1, x0, 0, 1, 0),
				pair_eq(x2, x1, x0, 1, 0, 1)
			)
		)
	);

	red = and(
		pair_eq(y2, y1, y0, 0, 1, 0), 
		or(
			pair_eq(x2, x1, x0, 0, 1, 0),
			pair_eq(x2, x1, x0, 1, 0, 1),
		),
	);

	C0 = red;
	C1 = -or(red, black);
	C3 = or(red, and(-black, R0));

	C4 = black;
}

ant 0 {
	() = main(T5, T4, T3, T2, T1, T0);
}
