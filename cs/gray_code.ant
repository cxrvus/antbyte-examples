set start = left;

set height = 3;
set fg = none;
set ticks = 15;
set speed = 15;

fn gray_code = (n3, n2, n1, n0) => (o3, o2, o1, o0) {
	(m3, m2, m1, m0) = fwd(0, n3, n2, n1); # rsh

	(o3, o2, o1, o0) = fwd(
		xor(n3, m3),
		xor(n2, m2),
		xor(n1, m1),
		xor(n0, m0)
	);
}

ant main = 1 {
	(COL_3, COL_2, COL_1, COL_0) = gray_code(CTR_3, CTR_2, CTR_1, CTR_0);
}
