cfg {
	start = top;
	keys = "ad e";
	speed = 4;
	start_tick = 1;
	fg = none;
	height = 128;
	width = 128;
}

cfg {
	layer_limit = 3;
	layer_filter = 0b1;
	border_0 = cycle;
	border_1 = obs;
	border_2 = die;
}

# cfg { size = 8; fps = 1; speed = 1; }

ant queen = 1 {
	SIG_0 = CTR;

	(_, right, left, _) = dec(X_IN_1, X_IN_0);
	(last_right, -last_left) = cpy(MEM_0);
	ROT_0 = or(and(left, last_right), and(right, last_left));
	MEM_0 = xor(MEM_0, ROT_0);

	HLT = or(SIG_0, and(-right, -left));
	(COL_3, COL_2) = cpy(-HLT);

	A_ID_1 = 1; A_ROT_1 = 1;
	A_ROT_0 = or(INL, left);
	KLL = 1;
}

ant sand_spawner = 2 {
	HLT = 1;
	DIE = and(-N_ID_20, -N_ID_60);
	(COL_3, COL_2) = cpy(and(-DIE, CTR_4));
	A_ID_2 = and(-DIE, X_IN_2);
	A_LYR = 1; A_ROT_0 = 1;

	SIG_1 = and(X_IN_3, PRB_2);

	CLR = INL;
}

ant sand = 4 {
	move = SIG_0;
	HLT = -move;

	(last_right, last_left) = fwd(MEM_1, MEM_0);

	# using RND_0 as a tie breaker
	(_, right1, left1, left2, _, right2, left3, right3) = dec(RND_0, -OBS_7, -OBS_1);
	right = or(right1, right2, right3);
	left = or(left1, left2, left3);

	(right, left) = fwd_and(OBS_0, right, left);
	right = mux(move, last_left, right);
	left = mux(move, last_right, left);

	ROT_2 = or(left, right);
	(ROT_0, ROT_1) = cpy(left);
	(MEM_1, MEM_0) = fwd_and(move, right, left);

	KLL = and(SIG_1, RND_0, -move, -right, -left);

	(A_LYR, A_ID_2, A_ID_0) = cpy(and(-KLL, move));
}

ant sand_color = 5 {
	HLT = 1;
	DIE = CTR_7;
	COL_3 = and(-INL, -DIE);
	(COL_2, COL_1, COL_0) = fwd(CTR_6, CTR_5, CTR_4);
}
