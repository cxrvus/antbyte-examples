set start = top;
set keys = "ad e";
set speed = 4;
set start_tick = 1;
set fg = none;

set height = 128;
set width = 128;

# set { size = 8; fps = 1; speed = 1; }

set layers = 3;
set layer_filter = 0b1;
set border_0 = cycle;
set border_1 = obs;
set border_2 = die;

ant queen = 1 {
	S0 = C;

	(_, right, left, _) = dec(X1, X0);
	(last_right, -last_left) = cpy(M0);
	R0 = or(and(left, last_right), and(right, last_left));
	M0 = xor(M0, R0);

	H = or(S0, and(-right, -left));
	(T3, T2) = cpy(-H);

	A1 = 1; AR1 = 1;
	AR0 = or(B, left);
	K = 1;
}

ant sand_spawner = 2 {
	H = 1;
	D = and(-VA20, -VA60);
	(T3, T2) = cpy(and(-D, C4));
	A2 = and(-D, X2);
	AA = 1; AR0 = 1;

	S1 = and(X3, N12);

	E = B;
}

ant sand = 4 {
	move = S0;
	H = -move;

	(last_right, last_left) = fwd(M1, M0);

	# using N0 as a tie breaker
	(_, right1, left1, left2, _, right2, left3, right3) = dec(N0, -V7, -V1);
	right = or(right1, right2, right3);
	left = or(left1, left2, left3);

	(right, left) = fwd_and(V0, right, left);
	right = mux(move, last_left, right);
	left = mux(move, last_right, left);

	R2 = or(left, right);
	(R0, R1) = cpy(left);
	(M1, M0) = fwd_and(move, right, left);

	K = and(S1, N0, -move, -right, -left);

	(AA, A2, A0) = cpy(and(-K, move));
}

ant sand_color = 5 {
	H = 1;
	D = C7;
	T3 = and(-B, -D);
	(T2, T1, T0) = fwd(C6, C5, C4);
}
