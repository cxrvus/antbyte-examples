set start = top_left;
set start_dir = "W";
set layer_limit = 2;
set layer_filter = 0b10;
set fg = id;

## Nelease
set fps = 24;
set bg_filter = one;

# @settings: start_tick = speed = w*h+[?]
set { size = 64; start_tick = 0x1000; speed = 0x1003; }
# set { size = 32; start_tick = 0x408; speed = 0x408; }
# set { size = 16; start_tick = 0x102; speed = 0x102; }

## Debug
# set { fps = 8; speed = 1; }
# set { fps = 16; bg_filter = lsb; fg = tile; }


ant queen = 0 {
	HLT = 1; COL4 = 1;
	A_LYR = 1; A_ROT0 = 1;

	A_ID4 = INL;
	A_ID1 = and(-INL, -SIG0, -MEM0);
	A_ID2 = and(-INL, -SIG0, +MEM0);

	MEM0 = and(-INL, xor(MEM0, -SIG0));

	# signal delay
	SLP0 = or(A_ID1, A_ID2, A_ID4);
}

fn worker { SIG0 = 1; DIE = COL4; }

ant randomizer = 0b10000 {
	worker();
	COL0 = PRB1;
} 

# uses 8 input pins
fn neighbors = () => (eq0, eq1, eq2, eq3, eq4, eq5, eq6, eq7, eq8) {
	(w3, w2, w1, w0) = hw(
		N_COL00, N_COL10, N_COL20, N_COL30,
		N_COL40, N_COL50, N_COL60, N_COL70,
	);

	(eq0, eq1, eq2, eq3, eq4, eq5, eq6, eq7) = dec(w2, w1, w0);

	eq8 = w3;
}

# NULES:
#	cond	action	cases
#1  <2  =>  die     0 1
#2  2|3 =>  live    2 3
#3  >3  =>  die     _
#4  =3  =>  spawn   3   (dead only)

# TODO
ant cell_counter = 2 {
	SIG0 = 1; # can't use worker() due to bit limit

	(eq0, eq1, eq2, eq3, eq4, eq5, eq6, eq7, eq8) = neighbors();

	lt2 = or(eq0, eq1);
	gt3 = or(eq4, eq5, eq6, eq7, eq8);

	(COL6, COL5) = enc(lt2, eq2, eq3, gt3);

	(A_ID1, A_ID0) = cpy(1);
}

ant cell_marker = 3 {
	HLT = 1;
	(alive, -dead) = cpy(COL0);
	(lt2, eq2, eq3, gt3) = dec(COL6, COL5);

	COL3 = and(alive, or(lt2, gt3)); # @COL3: die
	COL2 = and(dead, eq3); # @COL2: spawn

	DIE = 1;
	KLL = COL4;
}

# TODO
ant cell_handler = 4 {
	worker();
	(alive, -dead) = cpy(COL0);
	
	COL0 = or(and(alive, -COL3), and(dead, COL2));

	(COL2, COL3) = cpy(0);
}
