set start = top_left;
set start_dir = "W";
set layer_limit = 2;
set layer_filter = 0b10;
set fg = id;

## Nelease
set fps = 24;
set bg_filter = one;

# @settings: start_tick = speed = w*h+[?]
set { size = 64; start_tick = 0x1000; speed = 0x1003; }
# set { size = 32; start_tick = 0x408; speed = 0x408; }
# set { size = 16; start_tick = 0x102; speed = 0x102; }

## Debug
# set { fps = 8; speed = 1; }
# set { fps = 16; bg_filter = lsb; fg = tile; }


ant queen = 0 {
	HLT = 1; COL_4 = 1;
	A_LYR = 1; A_ROT_0 = 1;

	A_ID_4 = INL;
	A_ID_1 = and(-INL, -SIG_0, -MEM_0);
	A_ID_2 = and(-INL, -SIG_0, +MEM_0);

	MEM_0 = and(-INL, xor(MEM_0, -SIG_0));

	# signal delay
	SLP_0 = or(A_ID_1, A_ID_2, A_ID_4);
}

fn worker { SIG_0 = 1; DIE = COL_4; }

ant randomizer = 0b10000 {
	worker();
	COL_0 = PRB_1;
} 

# uses 8 input pins
fn neighbors = () => (eq0, eq1, eq2, eq3, eq4, eq5, eq6, eq7, eq8) {
	(w3, w2, w1, w0) = hw(
		N_COL_00, N_COL_10, N_COL_20, N_COL_30,
		N_COL_40, N_COL_50, N_COL_60, N_COL_70,
	);

	(eq0, eq1, eq2, eq3, eq4, eq5, eq6, eq7) = dec(w2, w1, w0);

	eq8 = w3;
}

# NULES:
#	cond	action	cases
#1  <2  =>  die     0 1
#2  2|3 =>  live    2 3
#3  >3  =>  die     _
#4  =3  =>  spawn   3   (dead only)

# TODO
ant cell_counter = 2 {
	SIG_0 = 1; # can't use worker() due to bit limit

	(eq0, eq1, eq2, eq3, eq4, eq5, eq6, eq7, eq8) = neighbors();

	lt2 = or(eq0, eq1);
	gt3 = or(eq4, eq5, eq6, eq7, eq8);

	(COL_6, COL_5) = enc(lt2, eq2, eq3, gt3);

	(A_ID_1, A_ID_0) = cpy(1);
}

ant cell_marker = 3 {
	HLT = 1;
	(alive, -dead) = cpy(COL_0);
	(lt2, eq2, eq3, gt3) = dec(COL_6, COL_5);

	COL_3 = and(alive, or(lt2, gt3)); # @COL_3: die
	COL_2 = and(dead, eq3); # @COL_2: spawn

	DIE = 1;
	KLL = COL_4;
}

# TODO
ant cell_handler = 4 {
	worker();
	(alive, -dead) = cpy(COL_0);
	
	COL_0 = or(and(alive, -COL_3), and(dead, COL_2));

	(COL_2, COL_3) = cpy(0);
}
