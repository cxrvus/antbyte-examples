use "../art/creeper";

cfg {
	speed = 64;
	size = 24;
	decay = 64;
	# fps = 24;
	layer_limit = 2;
	border_0 = cycle;
	border_1 = die;
	fg = none;
}

# cfg { fps = 12; speed = 1; fg = mem; }

ant queen = 0 {
	HLT = 1;
	A_ID_0 = CLK_5;
	A_LYR = 1; A_ROT_1 = 1;
	ROT_7 = A_ID_0;
}

ant column = 1 {
	DIE = and(CTR_2, CTR_1, CTR_0);

	(A_ID_1, A_ROT_0, A_ROT_1) = cpy(1);
	(A_MEM_2, A_MEM_1, A_MEM_0) = fwd(CTR_2, CTR_1, CTR_0);
}

ant rows = 2 {
	DIE = and(CTR_2, CTR_1, CTR_0);
	CLR = 1;
	creeper(MEM_2, MEM_1, MEM_0, CTR_2, CTR_1, CTR_0);
}
