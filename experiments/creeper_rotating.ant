use "../art/creeper";

set speed = 64;
set size = 24;
set decay = 64;
# set fps = 24;

set layer_limit = 2;
set border_0 = cycle;
set border_1 = die;
set fg = none;

# set { fps = 12; speed = 1; fg = mem; }

ant queen = 0 {
	HLT = 1;
	A_ID0 = EVR5;
	A_LYR = 1; A_ROT1 = 1;
	ROT7 = A_ID0;
}

ant column = 1 {
	DIE = and(CTR2, CTR1, CTR0);

	(A_ID1, A_ROT0, A_ROT1) = cpy(1);
	(A_MEM2, A_MEM1, A_MEM0) = fwd(CTR2, CTR1, CTR0);
}

ant rows = 2 {
	DIE = and(CTR2, CTR1, CTR0);
	CLR = 1;
	creeper(MEM2, MEM1, MEM0, CTR2, CTR1, CTR0);
}
