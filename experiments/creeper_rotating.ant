use "../art/creeper";

set speed = 64;
set size = 24;
set decay = 64;
# set fps = 24;

set layer_limit = 2;
set border_0 = cycle;
set border_1 = die;
set fg = none;

# set { fps = 12; speed = 1; fg = mem; }

ant queen = 0 {
	H = 1;
	A0 = E5;
	AA = 1; AR1 = 1;
	R7 = A0;
}

ant column = 1 {
	D = and(T2, T1, T0);

	(A1, AR0, AR1) = cpy(1);
	(AM2, AM1, AM0) = fwd(T2, T1, T0);
}

ant rows = 2 {
	D = and(T2, T1, T0);
	CZ = 1;
	creeper(M2, M1, M0, T2, T1, T0);
}
