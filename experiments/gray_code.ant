set start = top_left;

set height = 1;
set hide_ants = 1;
set ticks = 15;
set speed = 0;

fn gray_code = (n3, n2, n1, n0) => (o3, o2, o1, o0) {
	(m3, m2, m1, m0) = buf(0, n3, n2, n1); # rsh

	(o3, o2, o1, o0) = buf(
		xor(n3, m3),
		xor(n2, m2),
		xor(n1, m1),
		xor(n0, m0)
	);
}

ant main {
	(C3, C2, C1, C0) = gray_code(T3, T2, T1, T0);
}
