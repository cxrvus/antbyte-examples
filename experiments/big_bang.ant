set ant_limit = 0x1000;
set decay = 128;
set height = 0xff;
set width = 0xff;
set border = obs;
set speed = 4;
set fg = tile;
set bg = layers;

set layer_limit = 3;
set border_1 = cycle;
set border_2 = die;

ant 0 {
	A_ID = -or(SIG2, SIG1, SIG0);
	HLT = 1; A_ROT0 = 1; ROT2 = 1;
}

ant 1 {
	(A_ID1, A_LYR) = cpy(EVR2);
	A_ID0 = -A_ID1;

	ROT1 = cpy(CTR1);
	ROT0 = cpy(CTR2);

	(COL2, COL1, COL0) = fwd(CTR2, CTR1, CTR0);

	DIE = CTR7;

	SIG0 = 1;
}

ant 2 {
	COL3 = CTR;
	DIE = CTR7;
	(A_ID2, A_LYR) = cpy(PRB1);

	SIG1 = 1;
}

ant 4 {
	CLR = CTR;
	DIE = CTR2;

	SIG2 = 1;
}
