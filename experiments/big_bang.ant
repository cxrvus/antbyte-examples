set ant_limit = 0x1000;
set decay = 128;
set height = 0xff;
set width = 0xff;
set border = obs;
set speed = 4;
set fg = tile;
set bg = layers;

set layer_limit = 3;
set border_1 = cycle;
set border_2 = die;

ant 0 {
	A = -or(S2, S1, S0);
	H = 1; AR0 = 1; R2 = 1;
}

ant 1 {
	(A1, AA) = cpy(E2);
	A0 = -A1;

	R1 = cpy(T1);
	R0 = cpy(T2);

	(C2, C1, C0) = fwd(T2, T1, T0);

	D = T7;

	S0 = 1;
}

ant 2 {
	C3 = T;
	D = T7;
	(A2, AA) = cpy(P1);

	S1 = 1;
}

ant 4 {
	CZ = T;
	D = T2;

	S2 = 1;
}
