set ant_limit = 0x1000;
set decay = 128;
set height = 0xff;
set width = 0xff;
set border = obs;
set speed = 4;
set fg = tile;
set bg = layers;

set layer_limit = 3;
set border_1 = cycle;
set border_2 = die;

ant 0 {
	A_ID = -or(SIG_2, SIG_1, SIG_0);
	HLT = 1; A_ROT_0 = 1; ROT_2 = 1;
}

ant 1 {
	(A_ID_1, A_LYR) = cpy(EVR_2);
	A_ID_0 = -A_ID_1;

	ROT_1 = cpy(CTR_1);
	ROT_0 = cpy(CTR_2);

	(COL_2, COL_1, COL_0) = fwd(CTR_2, CTR_1, CTR_0);

	DIE = CTR_7;

	SIG_0 = 1;
}

ant 2 {
	COL_3 = CTR;
	DIE = CTR_7;
	(A_ID_2, A_LYR) = cpy(PRB_1);

	SIG_1 = 1;
}

ant 4 {
	CLR = CTR;
	DIE = CTR_2;

	SIG_2 = 1;
}
