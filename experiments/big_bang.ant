set ant_limit = 0x1000;
set decay = 128;
set height = 0xff;
set width = 0xff;
set border = obs;
set speed = 4;
set fg = tile;
set bg = layers;

set layers = 3;
set border_1 = cycle;
set border_2 = die;

ant 0 {
	A = -or(S2, S1, S0);
	H = 1; AR0 = 1; R2 = 1;
}

ant 1 {
	(A1, AA) = cpy(C12);
	A0 = -A1;

	R1 = cpy(C1);
	R0 = cpy(C2);

	(T2, T1, T0) = fwd(C2, C1, C0);

	D = C7;

	S0 = 1;
}

ant 2 {
	T3 = C;
	D = C7;
	(A2, AA) = cpy(N11);

	S1 = 1;
}

ant 4 {
	E = C;
	D = C2;

	S2 = 1;
}
