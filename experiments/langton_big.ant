set desc = "Langton's Ant, but bigger and with border=wrap and somne decay";
set height = 100;
set width = 70;
set border = wrap;
set decay = 5000;
set bg_filter = bin;
set speed = 64;

fn main = in_color => out_color {
	E = 1;

	out_color = -in_color;
	left = in_color;

	R1 = 1;
	R0 = left;
}

ant main = 1 {
	T2 = main(T2);
}
