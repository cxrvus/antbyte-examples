set desc = "Langton's Ant, but bigger and with border=wrap and somne decay";
set height = 100;
set width = 70;
set border = wrap;
set decay = 5000;
set bg_filter = bin;
set speed = 64;

def main(in_color) => out_color {
	CLR = 1;

	out_color = -in_color;
	left = in_color;

	ROT_1 = 1;
	ROT_0 = left;
}

ant main = 1 {
	COL_2 = main(COL_2);
}
