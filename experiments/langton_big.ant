cfg {
	_desc = "Langton's Ant, but bigger and with border=wrap and somne decay";
	height = 100;
	width = 70;
	border = wrap;
	decay = 5000;
	bg_filter = bin;
	speed = 64;
}

def main(in_color) => out_color {
	CLR = 1;

	out_color = -in_color;
	left = in_color;

	ROT_1 = 1;
	ROT_0 = left;
}

ant main = 1 {
	COL_2 = main(COL_2);
}
