set width = 256;
set height = 128;
set speed = 8;
set fps = 32;
set start = top_left;
set border = cycle;
# set border = die;

fn spike {
	E = 1;
	T1 = -T1;
	# T3 = C7;

	R1 = C2;
	R0 = C3;
	R2 = C7;
}

fn reproduce = () => spawn {
	spawn = and(C7, -or(
		C3,
		C2,
		C1,
		# C0,
	));
	D = and(C7, C4);
}

ant clone2 = 4 {
	() = spike();
}

ant clone = 2 {
	() = spike();
	A2 = reproduce();
}

ant main = 1 {
	() = spike();
	A1 = reproduce();
}
