cfg {
	width = 256;
	height = 128;
	speed = 8;
	fps = 32;
	start = top_left;
	border = cycle;
	# border = die;
}

def spike() {
	CLR = 1;
	COL_1 = -COL_1;
	# COL_3 = CTR_7;

	ROT_1 = CTR_2;
	ROT_0 = CTR_3;
	ROT_2 = CTR_7;
}

def reproduce() => spawn {
	spawn = and(CTR_7, -or(
		CTR_3,
		CTR_2,
		CTR_1,
		# CTR_0,
	));
	DIE = and(CTR_7, CTR_4);
}

ant clone2 = 4 {
	spike();
}

ant clone = 2 {
	spike();
	A_ID_2 = reproduce();
}

ant main = 1 {
	spike();
	A_ID_1 = reproduce();
}
