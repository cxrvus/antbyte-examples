set width = 256;
set height = 128;
set speed = 8;
set fps = 32;
set start = top_left;
set border = cycle;
# set border = die;

def spike() {
	CLR = 1;
	COL_1 = -COL_1;
	# COL_3 = CTR_7;

	ROT_1 = CTR_2;
	ROT_0 = CTR_3;
	ROT_2 = CTR_7;
}

def reproduce() => spawn {
	spawn = and(CTR_7, -or(
		CTR_3,
		CTR_2,
		CTR_1,
		# CTR_0,
	));
	DIE = and(CTR_7, CTR_4);
}

ant clone2 = 4 {
	spike();
}

ant clone = 2 {
	spike();
	A_ID_2 = reproduce();
}

ant main = 1 {
	spike();
	A_ID_1 = reproduce();
}
