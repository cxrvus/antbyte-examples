set width = 256;
set height = 128;
set speed = 8;
set fps = 32;
set start = top_left;
set border = cycle;
# set border = die;

fn spike {
	CLR = 1;
	COL1 = -COL1;
	# COL3 = CTR7;

	ROT1 = CTR2;
	ROT0 = CTR3;
	ROT2 = CTR7;
}

fn reproduce = () => spawn {
	spawn = and(CTR7, -or(
		CTR3,
		CTR2,
		CTR1,
		# CTR0,
	));
	DIE = and(CTR7, CTR4);
}

ant clone2 = 4 {
	spike();
}

ant clone = 2 {
	spike();
	A_ID2 = reproduce();
}

ant main = 1 {
	spike();
	A_ID1 = reproduce();
}
