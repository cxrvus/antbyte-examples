set fps = 30;
# set fps = 4;
set start_tick = 300;
set speed = 16;
set keys = "465";
set size = 128;
set loop;
set start_pos = top_right;
set start_dir = 4;
set fg = none;
set euclid;

set {
	border_0 = obs; 	# default: queen, UI
	border_1 = cycle;	# snake, snake spawner
	border_2 = cycle;	# enemy spawner
	border_3 = cycle;	# enemies
}

ant queen = 0 {
	HLT = -INL;
	(-spawn_snake, spawn_ui) = cpy(CTR);
	(A_ROT_2, A_LFT, A_ID_1, A_LYR) = cpy(spawn_snake);
	(DIE, A_ID_2) = cpy(spawn_ui);
}

ant snake_spawner = 2 {
	SIG_0 = 1;
	spawn_enemies = on(6'31);
	spawn_snake = on(6'63);

	DIE = spawn_snake;
	(A_ID_1:0) = cpy(or(spawn_snake, spawn_enemies));
	(A_ID_2, A_LYR) = cpy(spawn_enemies);
}

ant snake = 3 {
	SIG_0 = 1;
	COL_1 = 1;
	COL_3 = 1;

	(DCY_13:2) = cpy(1);
	LFT = X_IN_0;
	DIE = N_COL_3;
	break = and(X_IN_2, SIG_1);
	HLT = mux(break,, -CLK_3, -CLK_4);

	(ROT_7:6) = cpy(and(
		or(-HLT, CLK_2),
		or(X_IN_1:0)
	));

}

ant ui_end = 4 {
	(A_ID_2:1, A_ROT_0) = cpy(INL);
	COL_2 = 1;
	COL_3 = 1;
	DIE = OBS;
}

ant ui = 6 {
	HLT = -CLK_2;
	RST = 1;
	boost = X_IN_2;
	(ROT_0, -COL_2) = cpy(boost);
	DIE = -SIG_0;
	cant_boost = and(boost, OBS);
	SIG_1 = -cant_boost;
}

ant enemy_spawner = 7 {
	A_LYR = 1;
	(LFT, ROT_6:4) = fwd(RND_3:0);
	spawn = and(PRB_5, CLK_3);
	(enemy_id) = and(spawn, RND_4);
	(A_ID_3:0) = fwd(spawn, 0, 0, enemy_id);
	DIE = -SIG_0;
}

def enemy() => (col, dcy, die) {
	col = 1;
	dcy = 1;
	COL_3 = 1;
	die = N_COL_3;
}

ant worm = 8 {
	(COL_2, DCY_12, DIE) = enemy();

    HLT = -CLK_3;

    ROT_5 = HLT;
    ROT_7 = and(or(N_COL_73, N_COL_13), HLT);
    ROT_2 = and(or(OBS, N_COL_3), -HLT);

    LFT = or(
		and(HLT, RND),
		and(N_COL_13, -HLT)
	); 

    # DIE = and(N_COL_3, or(N_COL_63, N_COL_23), -HLT);
	DIE = or(DIE, -SIG_0);
}

ant laser = 9 {
	(COL_0, DCY_13, DIE) = enemy();
	SLP_3 = 1;
	DIE = or(DIE, CTR_7);
}
