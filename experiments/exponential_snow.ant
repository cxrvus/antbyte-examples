set ant_limit = 1024;
set decay = 128;
set height = 90;
set width = 280;
set border = cycle;
set speed = 32;
set fps = 12;

set start_dir = "S";
set start_pos = right;
set bg = birth_tick;
set bg_filter = bin;

ant main = 1 {
	A_ID0 = 1;

	(COL1, ROT1) = cpy(RND1);
	(COL2, ROT0) = cpy(RND2);

	DIE = CTR7;
}
