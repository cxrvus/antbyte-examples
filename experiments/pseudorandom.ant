set fps = 6;
set width = 4;
set start = top_left;
set border = die;

set desc = "randomness through mere conflict resolution";

ant queen {
	left = and(-T1, -T0);
	right = and(+T1, -T0);
	A0 = or(left, right);
	(AD2, AM) = cpy(left);

	Z = and(T2, -T1, T0);
	S = -Z;
}

ant spawner = 1 {
	W = 1;
	AD1 = 1;
	AD2 = M;
	A1 = -S;
	AM = M;
}

ant value = 2 { C1 = M; }

