set ant_limit = 1024;
set decay = 128;
set height = 90;
set width = 180;
set speed = 32;
set fps = 24;
set start_dir = "W";

set layer_limit = 4;

fn spreader = () => c {
	AR1 = 1;

	# AA = P5;
	AA = 1;

	(c, R1) = cpy(N1);
	(C3, R0) = cpy(N2);

	D = T7;
}

ant 0 {
	A0 = T0;
	W7 = 1;
	D = 0;
	_ = spreader();
}

ant 1 {
	A1 = 1;
	W6 = 1;
	C0 = spreader();
}

ant 2 {
	A2 = 1;
	W4 = 1;
	C0 = spreader();
}

ant 4 {
	A3 = 1;
	W2 = 1;
	C0 = spreader();
}

ant 8 {
	C0 = spreader();
}
