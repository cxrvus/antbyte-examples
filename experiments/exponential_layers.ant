set ant_limit = 1024;
set decay = 128;
set height = 90;
set width = 180;
set speed = 32;
set fps = 24;
set start_dir=4;

set layers = 4;

fn spreader = () => c {
	AR1 = 1;

	# AA = N15;
	AA = 1;

	(c, R1) = cpy(N1);
	(T3, R0) = cpy(N2);

	D = C7;
}

ant 0 {
	A0 = C0;
	W7 = 1;
	D = 0;
	_ = spreader();
}

ant 1 {
	A1 = 1;
	W6 = 1;
	T0 = spreader();
}

ant 2 {
	A2 = 1;
	W4 = 1;
	T0 = spreader();
}

ant 4 {
	A3 = 1;
	W2 = 1;
	T0 = spreader();
}

ant 8 {
	T0 = spreader();
}
