set ant_limit = 1024;
set decay = 128;
set height = 90;
set width = 180;
# set speed = 32;
set fps = 24;
set start_dir=4;

set layers = 4;
set main_layer = 3;

fn spreader = () => c {
	AD1 = 1;

	# AA = RR5;
	AA = 1;

	(c, D1) = cpy(R1);
	(C3, D2) = cpy(R2);

	Z = T7;
}

ant 0 {
	A0 = T0;
	W7 = 1;
	Z = 0;
	_ = spreader();
}

ant 1 {
	A1 = 1;
	W6 = 1;
	C0 = spreader();
}

ant 2 {
	A2 = 1;
	W4 = 1;
	C0 = spreader();
}

ant 4 {
	A3 = 1;
	W2 = 1;
	C0 = spreader();
}

ant 8 {
	C0 = spreader();
}
