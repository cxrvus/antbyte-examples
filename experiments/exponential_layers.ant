set ant_limit = 1024;
set decay = 128;
set height = 90;
set width = 180;
set speed = 32;
set fps = 24;
set start_dir = "W";

set layer_limit = 4;

fn spreader = () => c {
	A_ROT1 = 1;

	# A_LYR = PRB5;
	A_LYR = 1;

	(c, ROT1) = cpy(RND1);
	(COL3, ROT0) = cpy(RND2);

	DIE = CTR7;
}

ant 0 {
	A_ID0 = CTR0;
	SLP7 = 1;
	DIE = 0;
	_ = spreader();
}

ant 1 {
	A_ID1 = 1;
	SLP6 = 1;
	COL0 = spreader();
}

ant 2 {
	A_ID2 = 1;
	SLP4 = 1;
	COL0 = spreader();
}

ant 4 {
	A_ID3 = 1;
	SLP2 = 1;
	COL0 = spreader();
}

ant 8 {
	COL0 = spreader();
}
