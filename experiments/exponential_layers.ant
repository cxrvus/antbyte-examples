set ant_limit = 1024;
set decay = 128;
set height = 90;
set width = 180;
set speed = 32;
set fps = 24;
set start_dir = "W";

set layer_limit = 4;

fn spreader = () => c {
	A_ROT_1 = 1;

	# A_LYR = PRB_5;
	A_LYR = 1;

	(c, ROT_1) = cpy(RND_1);
	(COL_3, ROT_0) = cpy(RND_2);

	DIE = CTR_7;
}

ant 0 {
	A_ID_0 = CTR_0;
	SLP_7 = 1;
	DIE = 0;
	_ = spreader();
}

ant 1 {
	A_ID_1 = 1;
	SLP_6 = 1;
	COL_0 = spreader();
}

ant 2 {
	A_ID_2 = 1;
	SLP_4 = 1;
	COL_0 = spreader();
}

ant 4 {
	A_ID_3 = 1;
	SLP_2 = 1;
	COL_0 = spreader();
}

ant 8 {
	COL_0 = spreader();
}
