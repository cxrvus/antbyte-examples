set ant_limit = 1024;
set size = 29;
set fps = 20;
set start_tick = 32;
set decay = 64;

ant queen = 0 {
	(AM2, AM1, AM0) = buf(T2, T1, T0);

	end = and(T2, T1, T0);
	after_end = T3;

	A0 = -after_end;
	S = -after_end;

	D0 = end;
	(AD2, AD1, AD0) = cpy(end);
	D1 = and(-after_end, -end, T0);
}

ant main = 1 {
	C3 = 1;
	(C2, C1, C0) = buf(M2, M1, M0);
	(M2, M1, M0) = buf(M2, M1, M0);

	H = -M3;
	# H = and(-M3, R0);
	M3 = or(M3, -S);

	D1 = -V;
}
