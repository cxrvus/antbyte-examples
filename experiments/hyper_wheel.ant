set ant_limit = 1024;
set size = 29;
set fps = 20;
set start_tick = 32;
set decay = 64;

ant queen = 0 {
	(AM2, AM1, AM0) = fwd(C2, C1, C0);

	end = and(C2, C1, C0);
	after_end = C3;

	A0 = -after_end;
	S = -after_end;

	R2 = end;
	(AR0, AR1, AR2) = cpy(end);
	R1 = and(-after_end, -end, C0);
}

ant main = 1 {
	T3 = 1;
	(T2, T1, T0) = fwd(M2, M1, M0);
	(M2, M1, M0) = fwd(M2, M1, M0);

	H = -M3;
	# H = and(-M3, N0);
	M3 = or(M3, -S);

	R1 = -V;
}
