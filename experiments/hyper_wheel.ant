set ant_limit = 1024;
set size = 29;
set fps = 20;
set start_tick = 32;
set decay = 64;

ant queen = 0 {
	(A_MEM2, A_MEM1, A_MEM0) = fwd(CTR2, CTR1, CTR0);

	end = and(CTR2, CTR1, CTR0);
	after_end = CTR3;

	A_ID0 = -after_end;
	SIG = -after_end;

	ROT2 = end;
	(A_ROT0, A_ROT1, A_ROT2) = cpy(end);
	ROT1 = and(-after_end, -end, CTR0);
}

ant main = 1 {
	COL3 = 1;
	(COL2, COL1, COL0) = fwd(MEM2, MEM1, MEM0);
	(MEM2, MEM1, MEM0) = fwd(MEM2, MEM1, MEM0);

	HLT = -MEM3;
	# HLT = and(-MEM3, RND0);
	MEM3 = or(MEM3, -SIG);

	ROT1 = -N_OBS;
}
