set size = 256;
# set size = 16;
# set fps = 4;
set keys = "46";
set speed = 0x100;
set border = cycle;
set euclid = 1;
set decay = 16000;
set fg = id;

def mux2x4(s, a3:0, b3:0) => (o3:0) {
	o0 = mux(s, a0, b0);
	o1 = mux(s, a1, b1);
	o2 = mux(s, a2, b2);
	o3 = mux(s, a3, b3);
}

ant 0 {
    (left, right) = fwd(RND_7:6);
    (left, right) = fwd_and(xor(left, right), left, right);
 
    ROT_5 = and(or(left, right), -CLK_4);
    LFT = and(left, -CLK_4);
    HLT = -CLK_2;

	change = and(PRB_7, CLK_4);
	sign = and(change, RND_0);

	(d3:0) = mux2x4(sign, +4'01, -4'01);
	(d3:0) = fwd_and(change, d3:0);

	(cout, MEM_3:0) = add(sign, MEM_3:0, d3:0);
	(A_MEM_3:0) = fwd(MEM_3:0);
	(X_OUT_3:0) = fwd(A_MEM_3:0);

    spawn = CLK_2;
    A_ID_0 = spawn;
}

ant 1 {
	HLT = 1;
	(right, left) = fwd(on(3'0b0), on(3'0b11));
    A_ID_1 = or(right, left);
	(A_MEM_3:0) = fwd(MEM_3:0);
    A_ROT_1 = 1;
    A_LFT = left;
	DIE = left;
}

ant 2 {
	(t4:0) = add(MEM_3:0, 4'4);
    DIE = on(0, t4:0);
    COL_1 = DIE;
}
