use "../art/creeper";

set speed = 16;
set size = 64;
set decay = 0x400;
set fps = 24;

set layer_limit = 2;
set border_0 = cycle;
set border_1 = die;
set fg = none;

# set { fps = 12; speed = 1; fg = mem; }

ant queen = 0 {
	R1 = or(VC4, P2);

	(_, M1, M0) = add(M1, M0, 0, R1);

	A0 = and(-M1, -M0, CZ, P1);
	A0 = or(A0, B);

	AR2 = P4;
	AA = 1; AR1 = 1;
}

ant column = 1 {
	D = and(T2, T1, T0);

	(A1, AR0, AR1) = cpy(1);
	(AM2, AM1, AM0) = fwd(T2, T1, T0);
}

ant rows = 2 {
	D = and(T2, T1, T0);
	CZ = 1;
	creeper(M2, M1, M0, T2, T1, T0);
}
