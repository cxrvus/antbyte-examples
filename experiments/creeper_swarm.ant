use "../art/creeper";

set speed = 16;
set size = 64;
set decay = 0x400;
set fps = 24;

set layers = 2;
set border_0 = cycle;
set border_1 = die;
set fg = none;

# set { fps = 12; speed = 1; fg = mem; }

ant queen = 0 {
	R1 = or(VT4, N12);

	(_, M1, M0) = add(M1, M0, 0, R1);

	A0 = and(-M1, -M0, E, N11);
	A0 = or(A0, B);

	AR2 = N14;
	AA = 1; AR1 = 1;
}

ant column = 1 {
	Z = and(C2, C1, C0);

	(A1, AR0, AR1) = cpy(1);
	(AM2, AM1, AM0) = fwd(C2, C1, C0);
}

ant rows = 2 {
	Z = and(C2, C1, C0);
	E = 1;
	() = creeper(M2, M1, M0, C2, C1, C0);
}
