cfg {
	height = 64;
	width = 96;
	start_pos = bottom;
	start_dir = 6;
	fps = 8;
	speed = 4;
	border = die;
}

def green() { COL_1 = 1; }

ant queen = 0 {
	green();

	spawn_branch = and(RND_0, CLK_0);
	A_ID_2 = spawn_branch;
	(A_ROT_3:2) = cpy(1);

	MEM_0 = xor(MEM_0, spawn_branch);
	A_LFT = MEM_0;
}

ant branch = 4 {
	green();
	DIE = or(PRB_4, CTR_5);
	(A_ID_2, A_ID_0, A_ROT_4) = cpy(CTR_3);
	A_LFT = RND;
}

ant branch2 = 5 {
	green();
	DIE = or(PRB_3, CTR_3);
	LFT = RND;
	ROT_5 = PRB_2;
}
