set border = obs;
set start_dir = "S";
set keys = "wd";
set fps = 8;
set size = 32;

set layer_limit = 2;
set layer_filter = 0b10;
# set fg = layers;

ant queen = 0 {
	SIG0 = 1;

	HLT = -MEM0;
	MEM0 = INL;

	A_ID1 = INL;
	DIE = CTR6;
	A_ID2 = DIE;
	A_ROT0 = 1;
}

ant player_spawner = 2 {
	A_LYR = 1;
	(A_ID1, A_ID0) = cpy(1);
	DIE = CTR3;
	A_ROT1 = 1;
}

ant player_spawner2 = 3 {
	A_ID3 = 1;
	DIE = CTR3;
}

ant obstacle_spawner = 4 {
	A_LYR = 1;
	ROT2 = RND0;
	ROT1 = RND1;
	(A_ID2, A_ID0) = cpy(PRB2);
	DIE = CTR7;
}

ant obstacle = 5 { HLT = 1; }

ant player = 8 {
	HLT = or(SIG0, -X_IN0);
	ROT1 = and(-SIG0, X_IN1);
}
