set border = obs;
set start_dir = 2;
set keys = "wd";
set fps = 8;
set size = 32;

set layers = 2;
set layer_filter = 0b10;
# set fg = layers;

ant queen = 0 {
	S0 = 1;

	H = -M0;
	M0 = B;

	A1 = B;
	Z = C6;
	A2 = Z;
	AR0 = 1;
}

ant player_spawner = 2 {
	AA = 1;
	(A1, A0) = cpy(1);
	Z = C3;
	AR1 = 1;
}

ant player_spawner2 = 3 {
	A3 = 1;
	Z = C3;
}

ant obstacle_spawner = 4 {
	AA = 1;
	R2 = N0;
	R1 = N1;
	(A2, A0) = cpy(N12);
	Z = C7;
}

ant obstacle = 5 { H = 1; }

ant player = 8 {
	H = or(S0, -X0);
	R1 = and(-S0, X1);
}
