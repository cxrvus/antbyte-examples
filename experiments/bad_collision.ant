set border = obs;
set start_dir = "S";
set keys = "wd";
set fps = 8;
set size = 32;

set layer_limit = 2;
set layer_filter = 0b10;
# set fg = layers;

ant queen = 0 {
	SIG_0 = 1;

	HLT = -MEM_0;
	MEM_0 = INL;

	A_ID_1 = INL;
	DIE = CTR_6;
	A_ID_2 = DIE;
	A_ROT_0 = 1;
}

ant player_spawner = 2 {
	A_LYR = 1;
	(A_ID_1, A_ID_0) = cpy(1);
	DIE = CTR_3;
	A_ROT_1 = 1;
}

ant player_spawner2 = 3 {
	A_ID_3 = 1;
	DIE = CTR_3;
}

ant obstacle_spawner = 4 {
	A_LYR = 1;
	ROT_2 = RND_0;
	ROT_1 = RND_1;
	(A_ID_2, A_ID_0) = cpy(PRB_2);
	DIE = CTR_7;
}

ant obstacle = 5 { HLT = 1; }

ant player = 8 {
	HLT = or(SIG_0, -X_IN_0);
	ROT_1 = and(-SIG_0, X_IN_1);
}
