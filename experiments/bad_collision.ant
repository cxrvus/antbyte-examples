set border = obs;
set start_dir = 2;
set keys = "wd";
set fps = 8;
set size = 32;

set layers = 2;
set main_layer = 1;
# set fg = layers;

ant queen = 0 {
	S0 = 1;

	H = -M0;
	M0 = J;

	A1 = J;
	Z = T6;
	A2 = Z;
	AD2 = 1;
}

ant player_spawner = 2 {
	AA = 1;
	(A1, A0) = cpy(1);
	Z = T3;
	AD1 = 1;
}

ant player_spawner2 = 3 {
	A3 = 1;
	Z = T3;
}

ant obstacle_spawner = 4 {
	AA = 1;
	D0 = R0;
	D1 = R1;
	(A2, A0) = cpy(RR2);
	Z = T7;
}

ant obstacle = 5 { H = 1; }

ant player = 8 {
	H = or(S0, -K0);
	D1 = and(-S0, K1);
}
