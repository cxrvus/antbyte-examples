set size = 64;
set start = top_left;
set layer_limit = 2;
set layer_filter = 0b10;

set { 
	border_0 = obs;
	border_1 = die;
}

set { fg = none; }

ant 0 {
	spawn_cloud = T0;
	spawn_rain = -T0;

	A0 = spawn_cloud;
	AR1 = 1;
	AR0 = spawn_rain;
	A1 = spawn_rain;

	D = V;
}

ant cloud = 1 {
	C2 = 0;
	C3 = 1;
	D = T7;
	R2 = N0;
	R1 = N1;
}

ant rain_spawner = 2 {
	A2 = P3;
	AR0 = 1;
	AA0 = 1;

	C3 = 1;
}

ant rain_start = 4 {
	(A0, A2) = cpy(-C3);

	wind = and(-M1, P4);
	left = wind;
	right = M1;
	rot_32(left, right);
	TB = -wind;
	M1 = wind;
}

ant rain_end = 5 {
	H = 1;
	W1 = B;
	C2 = B;
	D = -B;
}
