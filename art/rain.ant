set size = 64;
set start = top_left;
set layers = 2;
set layer_filter = 0b10;

set { 
	border_0 = obs;
	border_1 = die;
}

set { fg = none; }

ant 0 {
	spawn_cloud = C0;
	spawn_rain = -C0;

	A0 = spawn_cloud;
	AR1 = 1;
	AR0 = spawn_rain;
	A1 = spawn_rain;

	Z = V;
}

ant cloud = 1 {
	T2 = 0;
	T3 = 1;
	Z = C7;
	R2 = N0;
	R1 = N1;
}

ant rain_spawner = 2 {
	A2 = N13;
	AR0 = 1;
	AA0 = 1;

	T3 = 1;
}

ant rain_start = 4 {
	(A0, A2) = cpy(-T3);

	wind = and(-M1, N14);
	left = wind;
	right = M1;
	() = rotd(left, right);
	F = -wind;
	M1 = wind;
}

ant rain_end = 5 {
	H = 1;
	W1 = B;
	T2 = B;
	Z = -B;
}
