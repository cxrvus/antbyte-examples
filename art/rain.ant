cfg {
	size = 64;
	start = top_left;
	layer_limit = 2;
	layer_filter = 0b10;
	fg = none;
}

cfg { 
	border_0 = obs;
	border_1 = die;
}

ant 0 {
	spawn_cloud = CTR_0;
	spawn_rain = -CTR_0;

	A_ID_0 = spawn_cloud;
	A_ROT_1 = 1;
	A_ROT_0 = spawn_rain;
	A_ID_1 = spawn_rain;

	DIE = OBS;
}

ant cloud = 1 {
	COL_2 = 0;
	COL_3 = 1;
	DIE = CTR_7;
	ROT_2 = RND_0;
	ROT_1 = RND_1;
}

ant rain_spawner = 2 {
	A_ID_2 = PRB_3;
	A_ROT_0 = 1;
	A_LYR_0 = 1;

	COL_3 = 1;
}

ant rain_start = 4 {
	(A_ID_0, A_ID_2) = cpy(-COL_3);

	wind = and(-MEM_1, PRB_4);
	left = wind;
	right = MEM_1;
	rot_32(left, right);
	TBK = -wind;
	MEM_1 = wind;
}

ant rain_end = 5 {
	HLT = 1;
	SLP_1 = INL;
	COL_2 = INL;
	DIE = -INL;
}
