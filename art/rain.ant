set size = 64;
set start = top_left;
set layer_limit = 2;
set layer_filter = 0b10;

set { 
	border_0 = obs;
	border_1 = die;
}

set { fg = none; }

ant 0 {
	spawn_cloud = CTR0;
	spawn_rain = -CTR0;

	A_ID0 = spawn_cloud;
	A_ROT1 = 1;
	A_ROT0 = spawn_rain;
	A_ID1 = spawn_rain;

	DIE = OBS;
}

ant cloud = 1 {
	COL2 = 0;
	COL3 = 1;
	DIE = CTR7;
	ROT2 = RND0;
	ROT1 = RND1;
}

ant rain_spawner = 2 {
	A_ID2 = PRB3;
	A_ROT0 = 1;
	A_LYR0 = 1;

	COL3 = 1;
}

ant rain_start = 4 {
	(A_ID0, A_ID2) = cpy(-COL3);

	wind = and(-MEM1, PRB4);
	left = wind;
	right = MEM1;
	rot_32(left, right);
	TBK = -wind;
	MEM1 = wind;
}

ant rain_end = 5 {
	HLT = 1;
	SLP1 = INL;
	COL2 = INL;
	DIE = -INL;
}
