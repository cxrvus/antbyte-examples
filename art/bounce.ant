set height = 31;
set width = 69;
set border = obs;
set start = top_left;
set fps = 24;
set speed = 8;
set ticks = 1500;
set loop;
set sleep = 100;
set start_dir = "NW";
set layer_limit = 2;

# set speed = 0;
# set height = 65;
# set width = 187;

fn bounce_ant {
	flip = and(-INL, OBS, MEM6);
	left = and(-INL, OBS);

	ROT0 = or(flip, left);
	ROT1 = and(-flip, left);
	HLT = OBS;

	MEM6 = OBS;
}

ant queen = 0 {
	(HLT, A_ROT0, A_LYR) = cpy(1);
	A_ID0 = INL;
	(A_ID1, DIE) = cpy(CTR4);
}

ant color = 1 {
	bounce_ant();

	change0 = or(OBS, -or(MEM2, MEM1, MEM0));
	change1 = and(change0, RND0);
	change2 = and(change0, RND1);

	(cout, MEM0) = add(MEM0, change0);
	(cout, MEM1) = add(MEM1, change1, cout);
	(_, MEM2) = add(MEM2, change2, cout);

	(COL2, COL1, COL0) = fwd(MEM2, MEM1, MEM0);
	COL3 = 1;
}

ant darken = 2 {
	bounce_ant();

	(COL2, COL1, COL0) = fwd(COL2, COL1, COL0);
	COL3 = 0;
}
