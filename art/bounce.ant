set height = 31;
set width = 69;
set border = obs;
set start = top_left;
set fps = 24;
set speed = 8;
set ticks = 1500;
set loop;
set sleep = 100;
set start_dir = 5;
set layers = 2;

# set speed = 0;
# set height = 65;
# set width = 187;

fn bounce_ant {
	flip = and(-B, V, M6);
	left = and(-B, V);

	R0 = or(flip, left);
	R1 = and(-flip, left);
	H = V;

	M6 = V;
}

ant queen = 0 {
	(H, AR0, AA) = cpy(1);
	A0 = B;
	(A1, Z) = cpy(C4);
}

ant color = 1 {
	() = bounce_ant();

	change0 = or(V, -or(M2, M1, M0));
	change1 = and(change0, N0);
	change2 = and(change0, N1);

	(cout, M0) = add(M0, change0);
	(cout, M1) = add(M1, change1, cout);
	(_, M2) = add(M2, change2, cout);

	(T2, T1, T0) = fwd(M2, M1, M0);
	T3 = 1;
}

ant darken = 2 {
	() = bounce_ant();

	(T2, T1, T0) = fwd(T2, T1, T0);
	T3 = 0;
}
