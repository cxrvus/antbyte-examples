set height = 31;
set width = 69;
set border = obs;
set start = top_left;
set fps = 24;
set speed = 8;
set ticks = 1500;
set loop;
set sleep = 100;
set start_dir = "NW";
set layer_limit = 2;

# set speed = 0;
# set height = 65;
# set width = 187;

fn bounce_ant {
	flip = and(-INL, OBS, MEM_6);
	left = and(-INL, OBS);

	ROT_0 = or(flip, left);
	ROT_1 = and(-flip, left);
	HLT = OBS;

	MEM_6 = OBS;
}

ant queen = 0 {
	(HLT, A_ROT_0, A_LYR) = cpy(1);
	A_ID_0 = INL;
	(A_ID_1, DIE) = cpy(CTR_4);
}

ant color = 1 {
	bounce_ant();

	change0 = or(OBS, -or(MEM_2, MEM_1, MEM_0));
	change1 = and(change0, RND_0);
	change2 = and(change0, RND_1);

	(cout, MEM_0) = add(MEM_0, change0);
	(cout, MEM_1) = add(MEM_1, change1, cout);
	(_, MEM_2) = add(MEM_2, change2, cout);

	(COL_2, COL_1, COL_0) = fwd(MEM_2, MEM_1, MEM_0);
	COL_3 = 1;
}

ant darken = 2 {
	bounce_ant();

	(COL_2, COL_1, COL_0) = fwd(COL_2, COL_1, COL_0);
	COL_3 = 0;
}
