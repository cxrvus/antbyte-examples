# set keys = "wdcf";
set border = die;
set size = 128;
set ant_limit = 1000;


set fg = none;
# set bg = birth_tick;
set decay = 64;

ant main = 1 {
	ROT_1 = RND_2;
	A_ID_0 = RND_3;

	MEM_0 = or(MEM_0, and(INL, RND_3));

	SLP_6 = and(-INL, CLK_4, MEM_0);

	COL_0 = 1;
	COL_1 = N_COL_20;
	COL_2 = N_COL_41;
	COL_3 = OBS_6;
}
