# set keys = "wdcf";
set border = die;
set size = 128;
set ant_limit = 1000;


set fg = none;
# set bg = birth_tick;
set decay = 64;

ant main = 1 {
	ROT1 = RND2;
	A_ID0 = RND3;

	MEM0 = or(MEM0, and(INL, RND3));

	SLP6 = and(-INL, EVR4, MEM0);

	COL0 = 1;
	COL1 = N_COL20;
	COL2 = N_COL41;
	COL3 = OBS6;
}
