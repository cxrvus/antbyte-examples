set start_pos = left;
set start_dir = 2;
set height = 32;
set width = 32;
set border = obs;
set fps = 12;
# set fps = 1;
set loop = 1;
set speed = 2;
set fg = none;

ant queen = 0 {
	(A1, AD1, AD2) = cpy(-M0);
	H = M0;
	M0 = or(M0, T1);

	S0 = -M0;
	S1 = and(M0, RR4);
	S2 = -T0;
}

ant queen2 = 2 {
	H = S0;
	(Z, A1, A0) = cpy(-S0);
}

ant cig_spawner = 3 {
	A2 = -M0;
	A3 = +M0;
	M0 = or(M0, T2);
	Z = on(0, 1, 1, 0, 0, 0);
}

ant filter = 4 {
	H = 1;
	(C1, C0) = cpy(1);
}

ant cig = 8 {
	H = 1;
			
	D2 = -V;
	M0 = or(M0, -V);
	lit = M0;

	(A3, A2, AD2) = cpy(lit);

	(C3, C0) = cpy(1);
	C2 = -lit;
	C1 = or(-lit, and(lit, RR2));

	Z = or(and(lit, S1), VA2);
	(C3, C2, C1, C0) = enb(-Z, C3, C2, C1, C0);
}

ant smoke = 12 {
	Z = and(V, -VA3);
	C3 = and(-Z, S2);
	H = C3;

	turn = R0;
	D1 = turn;
	D2 = and(-M0, turn);
	M0 = xor(M0, turn);
}
