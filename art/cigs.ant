set start_pos = left;
set start_dir = "S";
set height = 32;
set width = 32;
set border = obs;
set fps = 12;
set loop;
set speed = 4;
set layer_limit = 2;
set layer_filter = 0b10;
set fg = none;

# set start_tick = 500;
# set fps = 1;

ant queen = 0 {
	(A_ID_1, A_LYR, A_ROT_1, A_ROT_0) = cpy(-MEM_0);
	HLT = MEM_0;
	MEM_0 = or(MEM_0, CTR_1);

	SIG_0 = -MEM_0;
	SIG_1 = and(MEM_0, PRB_4);
	SIG_2 = -CTR_0;

	DIE = and(MEM_0, -SIG_3);
}

ant queen2 = 2 {
	SIG_3 = 1;
	HLT = SIG_0;
	(DIE, A_ID_1, A_ID_0) = cpy(-SIG_0);
}

ant cig_spawner = 3 {
	SIG_3 = 1;
	A_ID_2 = -MEM_0;
	A_ID_3 = +MEM_0;
	MEM_0 = or(MEM_0, CTR_2);
	DIE = on(0, 1, 1, 0, 0, 0);
}

ant filter = 4 {
	SIG_3 = 1;

	DIE = and(OBS, -N_ID_3, -N_ID_2, -N_ID_1);
	HLT = or(-MEM_0, SIG_2);
	(COL_1, COL_0) = cpy(and(HLT, -DIE));

	ROT_1 = and(-MEM_0, SIG_4);
	MEM_0 = or(MEM_0, SIG_4);
	SIG_4 = -OBS;
}

ant cig = 8 {
	HLT = 1;
			
	ROT_0 = -OBS;
	MEM_0 = or(MEM_0, -OBS);
	lit = MEM_0;

	(A_ID_3, A_ID_2, A_ROT_0) = cpy(lit);

	MEM_1 = xor(MEM_1, PRB_2);
	A_MEM_1 = MEM_1;

	(COL_3, COL_0) = cpy(1);
	COL_2 = -lit;
	COL_1 = or(-lit, and(lit, PRB_2));

	DIE = or(and(lit, SIG_1), N_ID_2);
	(COL_3, COL_2, COL_1, COL_0) = fwd_and(-DIE, COL_3, COL_2, COL_1, COL_0);
}

ant smoke = 12 {
	SIG_3 = 1;

	DIE = and(OBS, -N_ID_3);
	paint = and(-DIE, SIG_2);
	HLT = paint;
	(COL_3, COL_2, COL_1, COL_0) = fwd_and(paint, -MEM_1, MEM_1, MEM_1, MEM_1);

	turn = RND_0;
	ROT_1 = turn;
	ROT_0 = and(-MEM_0, turn);
	MEM_0 = xor(MEM_0, turn);
}
