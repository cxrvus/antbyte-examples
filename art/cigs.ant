set start_pos = left;
set start_dir = "S";
set height = 32;
set width = 32;
set border = obs;
set fps = 12;
set loop;
set speed = 4;
set layer_limit = 2;
set layer_filter = 0b10;
set fg = none;

# set start_tick = 500;
# set fps = 1;

ant queen = 0 {
	(A1, AA, AR1, AR0) = cpy(-M0);
	H = M0;
	M0 = or(M0, T1);

	S0 = -M0;
	S1 = and(M0, P4);
	S2 = -T0;

	D = and(M0, -S3);
}

ant queen2 = 2 {
	S3 = 1;
	H = S0;
	(D, A1, A0) = cpy(-S0);
}

ant cig_spawner = 3 {
	S3 = 1;
	A2 = -M0;
	A3 = +M0;
	M0 = or(M0, T2);
	D = on(0, 1, 1, 0, 0, 0);
}

ant filter = 4 {
	S3 = 1;

	D = and(V, -VA3, -VA2, -VA1);
	H = or(-M0, S2);
	(C1, C0) = cpy(and(H, -D));

	R1 = and(-M0, S4);
	M0 = or(M0, S4);
	S4 = -V;
}

ant cig = 8 {
	H = 1;
			
	R0 = -V;
	M0 = or(M0, -V);
	lit = M0;

	(A3, A2, AR0) = cpy(lit);

	M1 = xor(M1, P2);
	AM1 = M1;

	(C3, C0) = cpy(1);
	C2 = -lit;
	C1 = or(-lit, and(lit, P2));

	D = or(and(lit, S1), VA2);
	(C3, C2, C1, C0) = fwd_and(-D, C3, C2, C1, C0);
}

ant smoke = 12 {
	S3 = 1;

	D = and(V, -VA3);
	paint = and(-D, S2);
	H = paint;
	(C3, C2, C1, C0) = fwd_and(paint, -M1, M1, M1, M1);

	turn = N0;
	R1 = turn;
	R0 = and(-M0, turn);
	M0 = xor(M0, turn);
}
