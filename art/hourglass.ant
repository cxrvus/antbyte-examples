set size = 128;
set start = top_left;
set speed = 128;
set fps = 32;
set border = wrap;
set bg_filter = bin;

fn dir_change = (mem, clock) => (mem_out, dir) {
	dir = xor(mem, clock);
	mem_out = clock;
}

ant main = 1 {
	CLR = 1;
	COL0 = -COL0;

	(MEM2, ROT1) = dir_change(MEM2, CTR2);
	(MEM3, ROT0) = dir_change(MEM3, CTR3);
	(MEM7, ROT2) = dir_change(MEM7, CTR7);
}
