set size = 128;
set start = top_left;
set speed = 128;
set fps = 32;
set border = wrap;
set bg_filter = bin;

fn dir_change = (mem, clock) => (mem_out, dir) {
	dir = xor(mem, clock);
	mem_out = clock;
}

ant main = 1 {
	E = 1;
	T0 = -T0;

	(M2, R1) = dir_change(M2, C2);
	(M3, R0) = dir_change(M3, C3);
	(M7, R2) = dir_change(M7, C7);
}
