set width = 80;
set height = 32;
set loop;
set sleep = 5000;
# set size = 24;

set start = bottom_right;
set start_dir = "W";
set fps = 16;
# set fps = 4;

set layer_limit = 2;
set layer_filter = 0b1;
set border = die;
# set border = wrap;

ant queen = 0 {
	spawn_sky = INL;
	spawn_grass = and(-spawn_sky, or(RND_1, RND_2));
	spawn_flower = and(-spawn_grass, MEM_0, RND_0);

	A_ID_1 = spawn_sky;
	A_ID_2 = spawn_grass;
	A_ID_3 = spawn_flower;

	(A_LYR, -A_ROT_1) = cpy(spawn_sky);

	MEM_0 = spawn_grass;

	# ROT_1 = PRB_1;
}

ant sky_spawner = 2 {
	SLP_4 = INL;
	(A_ID_1, A_ID_0, A_ROT_1) = cpy(-INL);
	A_MEM_1 = RND_1;
}

ant sky = 3 {
	keep = COL_4;
	COL_2 = or(COL_2, -keep);
	COL_3 = mux(keep, or(PRB_1, xor(MEM_1, MEM_0)), COL_3);
	MEM_0 = xor(MEM_0, PRB_3);
}

ant grass_spawner = 4 {
	(A_MEM_3, A_MEM_2, A_MEM_1, A_MEM_0) = fwd(RND_3, RND_2, RND_1, RND_0);
	(DIE, HLT, A_ID_2, A_ID_0) = cpy(-INL);
}


ant grass = 5 {
	COL_4 = 1;
	COL_1 = 1;

	# min value
	(t1, t0) = fwd(MEM_1, MEM_0);
	(cout, t3, t2) = add(MEM_3, MEM_2, 0, 1);
	(t3, t2) = fwd(or(cout, t3), or(cout, t2));

	DIE = on(t3, t2, t1, t0);
	COL_3 = -and(DIE, MEM_1, MEM_0);
}


ant flower_spawner = 0b1000 {
	(DIE, HLT, A_ID_3, A_ID_0) = cpy(-INL);
	A_MEM_4 = PRB_1;
}

ant flower_rose = 0b1001 {
	COL_4 = 1;

	(tx0, tx1, tx2, tx3, tx4, tx5, tx6, tx7,
	 tx8, tx9, txa, txb, txc, txd, txe, txf)
	= dec(CTR_3, CTR_2, CTR_1, CTR_0);

	(COL_0, -COL_1) = cpy(MEM_0);
	COL_2 = and(COL_0, MEM_4);

	r1 = or(tx0);
	r2 = or(tx4, txc, txd, txe);
	r3 = or(txf);
	r4 = or(tx2, tx6);
	r5 = 0;
	r6 = or(tx8);
	r7 = or(tx7, txb);

	(ROT_0, ROT_1, ROT_2) = enc(0, r1, r2, r3, r4, r5, r6, r7);

	MEM_0 = or(MEM_0, txb);
	DIE = CTR_4;
	COL_3 = DIE;
}
