set width = 80;
set height = 32;
set loop;
set sleep = 5000;
# set size = 24;

set start = bottom_right;
set start_dir = "W";
set fps = 16;
# set fps = 4;

set layer_limit = 2;
set layer_filter = 0b1;
set border = die;
# set border = wrap;

ant queen = 0 {
	spawn_sky = B;
	spawn_grass = and(-spawn_sky, or(N1, N2));
	spawn_flower = and(-spawn_grass, M0, N0);

	A1 = spawn_sky;
	A2 = spawn_grass;
	A3 = spawn_flower;

	(AA, -AR1) = cpy(spawn_sky);

	M0 = spawn_grass;

	# R1 = P1;
}

ant sky_spawner = 2 {
	W4 = B;
	(A1, A0, AR1) = cpy(-B);
	AM1 = N1;
}

ant sky = 3 {
	keep = C4;
	C2 = or(C2, -keep);
	C3 = mux(keep, or(P1, xor(M1, M0)), C3);
	M0 = xor(M0, P3);
}

ant grass_spawner = 4 {
	(AM3, AM2, AM1, AM0) = fwd(N3, N2, N1, N0);
	(D, H, A2, A0) = cpy(-B);
}


ant grass = 5 {
	C4 = 1;
	C1 = 1;

	# min value
	(t1, t0) = fwd(M1, M0);
	(cout, t3, t2) = add(M3, M2, 0, 1);
	(t3, t2) = fwd(or(cout, t3), or(cout, t2));

	D = on(t3, t2, t1, t0);
	C3 = -and(D, M1, M0);
}


ant flower_spawner = 0b1000 {
	(D, H, A3, A0) = cpy(-B);
	AM4 = P1;
}

ant flower_rose = 0b1001 {
	C4 = 1;

	(tx0, tx1, tx2, tx3, tx4, tx5, tx6, tx7,
	 tx8, tx9, txa, txb, txc, txd, txe, txf)
	= dec(T3, T2, T1, T0);

	(C0, -C1) = cpy(M0);
	C2 = and(C0, M4);

	r1 = or(tx0);
	r2 = or(tx4, txc, txd, txe);
	r3 = or(txf);
	r4 = or(tx2, tx6);
	r5 = 0;
	r6 = or(tx8);
	r7 = or(tx7, txb);

	(R0, R1, R2) = enc(0, r1, r2, r3, r4, r5, r6, r7);

	M0 = or(M0, txb);
	D = T4;
	C3 = D;
}
