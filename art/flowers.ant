set width = 80;
set height = 32;
set loop;
set sleep = 5000;
# set size = 24;

set start = bottom_right;
set start_dir = "W";
set fps = 16;
# set fps = 4;

set layer_limit = 2;
set layer_filter = 0b1;
set border = die;
# set border = wrap;

ant queen = 0 {
	spawn_sky = INL;
	spawn_grass = and(-spawn_sky, or(RND1, RND2));
	spawn_flower = and(-spawn_grass, MEM0, RND0);

	A_ID1 = spawn_sky;
	A_ID2 = spawn_grass;
	A_ID3 = spawn_flower;

	(A_LYR, -A_ROT1) = cpy(spawn_sky);

	MEM0 = spawn_grass;

	# ROT1 = PRB1;
}

ant sky_spawner = 2 {
	SLP4 = INL;
	(A_ID1, A_ID0, A_ROT1) = cpy(-INL);
	A_MEM1 = RND1;
}

ant sky = 3 {
	keep = COL4;
	COL2 = or(COL2, -keep);
	COL3 = mux(keep, or(PRB1, xor(MEM1, MEM0)), COL3);
	MEM0 = xor(MEM0, PRB3);
}

ant grass_spawner = 4 {
	(A_MEM3, A_MEM2, A_MEM1, A_MEM0) = fwd(RND3, RND2, RND1, RND0);
	(DIE, HLT, A_ID2, A_ID0) = cpy(-INL);
}


ant grass = 5 {
	COL4 = 1;
	COL1 = 1;

	# min value
	(t1, t0) = fwd(MEM1, MEM0);
	(cout, t3, t2) = add(MEM3, MEM2, 0, 1);
	(t3, t2) = fwd(or(cout, t3), or(cout, t2));

	DIE = on(t3, t2, t1, t0);
	COL3 = -and(DIE, MEM1, MEM0);
}


ant flower_spawner = 0b1000 {
	(DIE, HLT, A_ID3, A_ID0) = cpy(-INL);
	A_MEM4 = PRB1;
}

ant flower_rose = 0b1001 {
	COL4 = 1;

	(tx0, tx1, tx2, tx3, tx4, tx5, tx6, tx7,
	 tx8, tx9, txa, txb, txc, txd, txe, txf)
	= dec(CTR3, CTR2, CTR1, CTR0);

	(COL0, -COL1) = cpy(MEM0);
	COL2 = and(COL0, MEM4);

	r1 = or(tx0);
	r2 = or(tx4, txc, txd, txe);
	r3 = or(txf);
	r4 = or(tx2, tx6);
	r5 = 0;
	r6 = or(tx8);
	r7 = or(tx7, txb);

	(ROT0, ROT1, ROT2) = enc(0, r1, r2, r3, r4, r5, r6, r7);

	MEM0 = or(MEM0, txb);
	DIE = CTR4;
	COL3 = DIE;
}
