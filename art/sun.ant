set start = top_left;
set size = 64;
set layer_limit = 3;
set start_dir = "SE";

# set start_tick = 4000;
# set fg = id;
set speed = 16;
set layer_filter = 0b10;

set {
	border_0 = wrap;
	border_2 = die;
}

ant queen = 0 {
	(A_ID_4, A_ID_1) = cpy(INL);
	(A_ID_0, A_LYR_0) = cpy(and(-INL, EVR_3));
	(A_ROT_0, A_ROT_1, A_ROT_2) = cpy(1);
	DIE = A_ID_0;
}

fn slow { SLP_3 = 1; }

##### Layer 1

ant shell = 1 {
	slow();

	spawn_ray = EVR_2;
	turn = and(-INL, spawn_ray);
	spawn_core = N_COL_0;

	ROT_2 = turn;
	A_ID_0 = spawn_ray;
	A_ID_1 = or(spawn_ray, spawn_core);
	A_ID_2 = spawn_core;
	A_ROT_2 = spawn_core;
	A_ROT_1 = spawn_ray;
	A_ROT_0 = spawn_core;
	A_LYR_0 = spawn_ray;
	DIE = spawn_core;

	CLR = 1;
	COL_5 = 1;
	COL_0 = 1;
}

ant core = 2 {
	slow();

	COL_5 = 1;

	COL_0 = -COL_4;
	COL_1 = and(-COL_4, -INL);
	COL_2 = 0;
	COL_3 = 0;

	MEM_2 = MEM_1;
	MEM_1 = MEM_0;

	(ROT_2, HLT, MEM_0) = cpy(N_COL_5);
	DIE = and(MEM_2, MEM_1, MEM_0);
}

ant face = 4 {
	spawn_smile = and(CTR_4, CTR_2);
	spawn_shades = on(1, 1, 0, 0);

	A_ID_2 = or(spawn_smile, spawn_shades);
	A_ID_1 = spawn_shades;
	A_ID_0 = or(spawn_smile, spawn_shades);

	(A_ROT_0, A_ROT_1) = cpy(1);

	ROT_1 = or(
		on(1, 0, 0, 0),
		spawn_shades,
	);

	ROT_0 = or(
		spawn_shades,
	);

	DIE = spawn_smile;
}

ant smile = 5 {
	right = or(
		on(0, 1, 0, 0),
		on(1, 1, 1, 0),
	);
	left = or(
		on(0, 1, 0, 1),
		on(1, 1, 0, 1),
	);

	MEM_4 = or(MEM_4, on(0, 0, 1, 0));
	COL_4 = MEM_4;

	rot_32(left, right);

	DIE = CTR_4;
}

ant queen2 = 6 {
	HLT = 1;

	A_ID_1 = -CTR_0;
	A_ID_2 = CTR_0;

	A_ROT_0 = 1;
	A_ROT_1 = A_ID_2;

	DIE = A_ID_2;
}

ant shades = 7 {
	COL_4 = 1;
	(A_ID_3, A_ROT_1) = cpy(or(
		on(0, 1, 0, 0),
		on(1, 1, 0, 0),
	));

	DIE = on(1, 1, 1, 1);
}

ant lense = 8 {
	COL_4 = 1;
	(ROT_0, ROT_1) = cpy(or(
		on(0, 0, 1, 0),
		on(0, 1, 0, 0),
		on(0, 1, 0, 1),
	));
	DIE = on(0, 1, 1, 0);
}

##### Layer 0

ant sky = 18 {
	SIG_0 = 1;
	DIE = COL_2;

	keep = or(COL_4, COL_5);
	COL_2 = -keep;
	COL_3 = and(-keep, MEM_3);
	MEM_3 = xor(MEM_3, PRB_5);
}

##### Layer 2

ant ray_spawner = 3 {
	active = -SIG_0;

	HLT = 1;
	A_ROT_0 = 1;
	(A_ID_3, A_ID_0) = cpy(and(active, EVR_5));
	SLP_3 = 1;
}

ant ray_head = 9 {
	(A_ID_3, A_ID_1) = cpy(CTR_2);
	SLP_5 = 1;
}

ant ray_tail = 10 {
	c3 = COL_3;
	COL_3 = mux(INL, MEM_3, 0);
	MEM_3 = c3;

	(COL_0, COL_1) = cpy(INL);
	COL_2 = -INL;

	HLT = 1;
	SLP_7 = 1;
	DIE = -INL;
}

