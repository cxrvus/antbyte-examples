use "../lib/time";

set start = top_left;
set size = 64;
set layers = 3;
set start_dir = 1;

# set start_tick = 4000;
# set fg = id;
set speed = 16;
set main_layer = 1;

set {
	border_0 = wrap;
	border_2 = die;
}

ant queen = 0 {
	(A4, A1) = cpy(J);
	(A0, AA0) = cpy(and(-J, TT3));
	(AD2, AD1, AD0) = cpy(1);
	Z = A0;
}

fn slow = () => () {
	W3 = 1;
}

##### Layer 1

ant shell = 1 {
	() = slow();

	spawn_ray = TT2;
	turn = and(-J, spawn_ray);
	spawn_core = VC0;

	D0 = turn;
	A0 = spawn_ray;
	A1 = or(spawn_ray, spawn_core);
	A2 = spawn_core;
	AD0 = spawn_core;
	AD1 = spawn_ray;
	AD2 = spawn_core;
	AA0 = spawn_ray;
	Z = spawn_core;

	CC = 1;
	C5 = 1;
	C0 = 1;
}

ant core = 2 {
	() = slow();

	C5 = 1;

	C0 = -C4;
	C1 = and(-C4, -J);
	C2 = 0;
	C3 = 0;

	M2 = M1;
	M1 = M0;

	(D0, H, M0) = cpy(VC5);
	Z = and(M2, M1, M0);
}

ant face = 4 {
	spawn_smile = and(T4, T2);
	spawn_shades = on(1, 1, 0, 0);

	A2 = or(spawn_smile, spawn_shades);
	A1 = spawn_shades;
	A0 = or(spawn_smile, spawn_shades);

	(AD2, AD1) = cpy(1);

	D1 = or(
		on(1, 0, 0, 0),
		spawn_shades,
	);

	D2 = or(
		spawn_shades,
	);

	Z = spawn_smile;
}

ant smile = 5 {
	right = or(
		on(0, 1, 0, 0),
		on(1, 1, 1, 0),
	);
	left = or(
		on(0, 1, 0, 1),
		on(1, 1, 0, 1),
	);

	M4 = or(M4, on(0, 0, 1, 0));
	C4 = M4;

	D0 = or(left, right);
	D1 = left;
	D2 = left;

	Z = T4;
}

ant queen2 = 6 {
	H = 1;

	A1 = -T0;
	A2 = T0;

	AD2 = 1;
	AD1 = A2;

	Z = A2;
}

ant shades = 7 {
	C4 = 1;
	(A3, AD1) = cpy(or(
		on(0, 1, 0, 0),
		on(1, 1, 0, 0),
	));

	Z = on(1, 1, 1, 1);
}

ant lense = 8 {
	C4 = 1;
	(D2, D1) = cpy(or(
		on(0, 0, 1, 0),
		on(0, 1, 0, 0),
		on(0, 1, 0, 1),
	));
	Z = on(0, 1, 1, 0);
}

##### Layer 0

ant sky = 18 {
	S0 = 1;
	Z = C2;

	keep = or(C4, C5);
	C2 = -keep;
	C3 = and(-keep, M3);
	M3 = xor(M3, RR5);
}

##### Layer 2

ant ray_spawner = 3 {
	active = -S0;

	H = 1;
	AD2 = 1;
	(A3, A0) = cpy(and(active, TT5));
	W3 = 1;
}

ant ray_head = 9 {
	(A3, A1) = cpy(T2);
	W5 = 1;
}

ant ray_tail = 10 {
	c3 = C3;
	C3 = mux(J, M3, 0);
	M3 = c3;

	(C0, C1) = cpy(J);
	C2 = -J;

	H = 1;
	W7 = 1;
	Z = -J;
}

