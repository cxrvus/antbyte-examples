set start = top_left;
set size = 64;
set layer_limit = 3;
set start_dir = "SE";

# set start_tick = 4000;
# set fg = id;
set speed = 16;
set layer_filter = 0b10;

set {
	border_0 = wrap;
	border_2 = die;
}

ant queen = 0 {
	(A_ID4, A_ID1) = cpy(INL);
	(A_ID0, A_LYR0) = cpy(and(-INL, EVR3));
	(A_ROT0, A_ROT1, A_ROT2) = cpy(1);
	DIE = A_ID0;
}

fn slow { SLP3 = 1; }

##### Layer 1

ant shell = 1 {
	slow();

	spawn_ray = EVR2;
	turn = and(-INL, spawn_ray);
	spawn_core = N_COL0;

	ROT2 = turn;
	A_ID0 = spawn_ray;
	A_ID1 = or(spawn_ray, spawn_core);
	A_ID2 = spawn_core;
	A_ROT2 = spawn_core;
	A_ROT1 = spawn_ray;
	A_ROT0 = spawn_core;
	A_LYR0 = spawn_ray;
	DIE = spawn_core;

	CLR = 1;
	COL5 = 1;
	COL0 = 1;
}

ant core = 2 {
	slow();

	COL5 = 1;

	COL0 = -COL4;
	COL1 = and(-COL4, -INL);
	COL2 = 0;
	COL3 = 0;

	MEM2 = MEM1;
	MEM1 = MEM0;

	(ROT2, HLT, MEM0) = cpy(N_COL5);
	DIE = and(MEM2, MEM1, MEM0);
}

ant face = 4 {
	spawn_smile = and(CTR4, CTR2);
	spawn_shades = on(1, 1, 0, 0);

	A_ID2 = or(spawn_smile, spawn_shades);
	A_ID1 = spawn_shades;
	A_ID0 = or(spawn_smile, spawn_shades);

	(A_ROT0, A_ROT1) = cpy(1);

	ROT1 = or(
		on(1, 0, 0, 0),
		spawn_shades,
	);

	ROT0 = or(
		spawn_shades,
	);

	DIE = spawn_smile;
}

ant smile = 5 {
	right = or(
		on(0, 1, 0, 0),
		on(1, 1, 1, 0),
	);
	left = or(
		on(0, 1, 0, 1),
		on(1, 1, 0, 1),
	);

	MEM4 = or(MEM4, on(0, 0, 1, 0));
	COL4 = MEM4;

	rot_32(left, right);

	DIE = CTR4;
}

ant queen2 = 6 {
	HLT = 1;

	A_ID1 = -CTR0;
	A_ID2 = CTR0;

	A_ROT0 = 1;
	A_ROT1 = A_ID2;

	DIE = A_ID2;
}

ant shades = 7 {
	COL4 = 1;
	(A_ID3, A_ROT1) = cpy(or(
		on(0, 1, 0, 0),
		on(1, 1, 0, 0),
	));

	DIE = on(1, 1, 1, 1);
}

ant lense = 8 {
	COL4 = 1;
	(ROT0, ROT1) = cpy(or(
		on(0, 0, 1, 0),
		on(0, 1, 0, 0),
		on(0, 1, 0, 1),
	));
	DIE = on(0, 1, 1, 0);
}

##### Layer 0

ant sky = 18 {
	SIG0 = 1;
	DIE = COL2;

	keep = or(COL4, COL5);
	COL2 = -keep;
	COL3 = and(-keep, MEM3);
	MEM3 = xor(MEM3, PRB5);
}

##### Layer 2

ant ray_spawner = 3 {
	active = -SIG0;

	HLT = 1;
	A_ROT0 = 1;
	(A_ID3, A_ID0) = cpy(and(active, EVR5));
	SLP3 = 1;
}

ant ray_head = 9 {
	(A_ID3, A_ID1) = cpy(CTR2);
	SLP5 = 1;
}

ant ray_tail = 10 {
	c3 = COL3;
	COL3 = mux(INL, MEM3, 0);
	MEM3 = c3;

	(COL0, COL1) = cpy(INL);
	COL2 = -INL;

	HLT = 1;
	SLP7 = 1;
	DIE = -INL;
}

