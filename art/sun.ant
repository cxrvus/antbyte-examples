set start = top_left;
set size = 64;
set layer_limit = 3;
set start_dir = "SE";

# set start_tick = 4000;
# set fg = id;
set speed = 16;
set layer_filter = 0b10;

set {
	border_0 = wrap;
	border_2 = die;
}

ant queen = 0 {
	(A4, A1) = cpy(B);
	(A0, AA0) = cpy(and(-B, E3));
	(AR0, AR1, AR2) = cpy(1);
	D = A0;
}

fn slow { W3 = 1; }

##### Layer 1

ant shell = 1 {
	slow();

	spawn_ray = E2;
	turn = and(-B, spawn_ray);
	spawn_core = VC0;

	R2 = turn;
	A0 = spawn_ray;
	A1 = or(spawn_ray, spawn_core);
	A2 = spawn_core;
	AR2 = spawn_core;
	AR1 = spawn_ray;
	AR0 = spawn_core;
	AA0 = spawn_ray;
	D = spawn_core;

	CZ = 1;
	C5 = 1;
	C0 = 1;
}

ant core = 2 {
	slow();

	C5 = 1;

	C0 = -C4;
	C1 = and(-C4, -B);
	C2 = 0;
	C3 = 0;

	M2 = M1;
	M1 = M0;

	(R2, H, M0) = cpy(VC5);
	D = and(M2, M1, M0);
}

ant face = 4 {
	spawn_smile = and(T4, T2);
	spawn_shades = on(1, 1, 0, 0);

	A2 = or(spawn_smile, spawn_shades);
	A1 = spawn_shades;
	A0 = or(spawn_smile, spawn_shades);

	(AR0, AR1) = cpy(1);

	R1 = or(
		on(1, 0, 0, 0),
		spawn_shades,
	);

	R0 = or(
		spawn_shades,
	);

	D = spawn_smile;
}

ant smile = 5 {
	right = or(
		on(0, 1, 0, 0),
		on(1, 1, 1, 0),
	);
	left = or(
		on(0, 1, 0, 1),
		on(1, 1, 0, 1),
	);

	M4 = or(M4, on(0, 0, 1, 0));
	C4 = M4;

	rot_32(left, right);

	D = T4;
}

ant queen2 = 6 {
	H = 1;

	A1 = -T0;
	A2 = T0;

	AR0 = 1;
	AR1 = A2;

	D = A2;
}

ant shades = 7 {
	C4 = 1;
	(A3, AR1) = cpy(or(
		on(0, 1, 0, 0),
		on(1, 1, 0, 0),
	));

	D = on(1, 1, 1, 1);
}

ant lense = 8 {
	C4 = 1;
	(R0, R1) = cpy(or(
		on(0, 0, 1, 0),
		on(0, 1, 0, 0),
		on(0, 1, 0, 1),
	));
	D = on(0, 1, 1, 0);
}

##### Layer 0

ant sky = 18 {
	S0 = 1;
	D = C2;

	keep = or(C4, C5);
	C2 = -keep;
	C3 = and(-keep, M3);
	M3 = xor(M3, P5);
}

##### Layer 2

ant ray_spawner = 3 {
	active = -S0;

	H = 1;
	AR0 = 1;
	(A3, A0) = cpy(and(active, E5));
	W3 = 1;
}

ant ray_head = 9 {
	(A3, A1) = cpy(T2);
	W5 = 1;
}

ant ray_tail = 10 {
	c3 = C3;
	C3 = mux(B, M3, 0);
	M3 = c3;

	(C0, C1) = cpy(B);
	C2 = -B;

	H = 1;
	W7 = 1;
	D = -B;
}

