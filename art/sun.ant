set start = top_left;
set size = 64;
set layers = 3;
set start_dir = 1;

# set start_tick = 4000;
# set fg = id;
set speed = 16;
set layer_filter = 0b10;

set {
	border_0 = wrap;
	border_2 = die;
}

ant queen = 0 {
	(A4, A1) = cpy(B);
	(A0, AA0) = cpy(and(-B, C13));
	(AR0, AR1, AR2) = cpy(1);
	Z = A0;
}

fn slow { W3 = 1; }

##### Layer 1

ant shell = 1 {
	() = slow();

	spawn_ray = C12;
	turn = and(-B, spawn_ray);
	spawn_core = VT0;

	R2 = turn;
	A0 = spawn_ray;
	A1 = or(spawn_ray, spawn_core);
	A2 = spawn_core;
	AR2 = spawn_core;
	AR1 = spawn_ray;
	AR0 = spawn_core;
	AA0 = spawn_ray;
	Z = spawn_core;

	E = 1;
	T5 = 1;
	T0 = 1;
}

ant core = 2 {
	() = slow();

	T5 = 1;

	T0 = -T4;
	T1 = and(-T4, -B);
	T2 = 0;
	T3 = 0;

	M2 = M1;
	M1 = M0;

	(R2, H, M0) = cpy(VT5);
	Z = and(M2, M1, M0);
}

ant face = 4 {
	spawn_smile = and(C4, C2);
	spawn_shades = on(1, 1, 0, 0);

	A2 = or(spawn_smile, spawn_shades);
	A1 = spawn_shades;
	A0 = or(spawn_smile, spawn_shades);

	(AR0, AR1) = cpy(1);

	R1 = or(
		on(1, 0, 0, 0),
		spawn_shades,
	);

	R0 = or(
		spawn_shades,
	);

	Z = spawn_smile;
}

ant smile = 5 {
	right = or(
		on(0, 1, 0, 0),
		on(1, 1, 1, 0),
	);
	left = or(
		on(0, 1, 0, 1),
		on(1, 1, 0, 1),
	);

	M4 = or(M4, on(0, 0, 1, 0));
	T4 = M4;

	() = rotd(left, right);

	Z = C4;
}

ant queen2 = 6 {
	H = 1;

	A1 = -C0;
	A2 = C0;

	AR0 = 1;
	AR1 = A2;

	Z = A2;
}

ant shades = 7 {
	T4 = 1;
	(A3, AR1) = cpy(or(
		on(0, 1, 0, 0),
		on(1, 1, 0, 0),
	));

	Z = on(1, 1, 1, 1);
}

ant lense = 8 {
	T4 = 1;
	(R0, R1) = cpy(or(
		on(0, 0, 1, 0),
		on(0, 1, 0, 0),
		on(0, 1, 0, 1),
	));
	Z = on(0, 1, 1, 0);
}

##### Layer 0

ant sky = 18 {
	S0 = 1;
	Z = T2;

	keep = or(T4, T5);
	T2 = -keep;
	T3 = and(-keep, M3);
	M3 = xor(M3, N15);
}

##### Layer 2

ant ray_spawner = 3 {
	active = -S0;

	H = 1;
	AR0 = 1;
	(A3, A0) = cpy(and(active, C15));
	W3 = 1;
}

ant ray_head = 9 {
	(A3, A1) = cpy(C2);
	W5 = 1;
}

ant ray_tail = 10 {
	t3 = T3;
	T3 = mux(B, M3, 0);
	M3 = t3;

	(T0, T1) = cpy(B);
	T2 = -B;

	H = 1;
	W7 = 1;
	Z = -B;
}

