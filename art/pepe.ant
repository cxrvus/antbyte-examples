set start = bottom_left;
set height = 12;
set width = 20;
set border = obs;
set layer_limit = 2;
set speed = 2;
set fps = 6;
# set fps = 2;

ant queen = 0 {
	(A_ID_3, A_ROT_0, A_ROT_1) = cpy(on(0, 0, 1, 1));
	(A_ID_1, A_ID_0, DIE, ) = cpy(on(1, 1, 1, 0));
}

ant clk = 3 { HLT = 1; SIG_0 = CTR_0; SIG_1 = CLK_4; }

ant cig = 1 {
	A_MEM_0 = INL; A_MEM_2 = CTR_2; A_MEM_1 = -or(A_MEM_0, A_MEM_2); DIE = A_MEM_2;
	(A_ID_1, A_ROT_0, A_ROT_1) = cpy(1);
}

ant cig_part = 2 {
	TBK = 1;

	(move, -HLT, ROT_0) = cpy(SIG_1);
	(is_up, MEM_3) = cpy(xor(MEM_3, SIG_1));

	filter = MEM_0;
	core = MEM_1;
	(brown, white, gray) = fwd_and(-move, MEM_0, MEM_1, MEM_2);

	COL_3 = white; COL_2 = or(white, gray); COL_1 = or(white, brown, gray);
	COL_0 = or(COL_1, and(move, filter, is_up));
	COL_4 = or(COL_3, COL_2, COL_1, COL_0);

	(A_ID_2, A_LYR, A_ROT_0, A_ROT_1) = cpy(and(core, is_up, -move));
}

ant smoke = 4 {
	DIE = or(SIG_2, and(OBS, -N_ID_2));
	keep = COL_4;
	paint = and(-DIE, SIG_0, -keep);

	HLT = SIG_0;
	COL_3 = or(paint, and(keep, COL_0));

	turn = RND_0;
	ROT_1 = turn;
	ROT_0 = and(-MEM_0, turn);
	MEM_0 = xor(MEM_0, turn);
}

ant frog = 0x8 {
	HLT = INL;
	DIE = CTR_3;

	right = or(on(0, 1, 1), on(1, 0, 1));
	left =  or(on(1, 0, 0), on(1, 1, 0));
	
	A_ID_3 = and(-INL, -DIE);
	(A_ID_2, A_ID_1, A_ID_0) = fwd_and(A_ID_3, CTR_2, CTR_1, CTR_0);
	(A_ROT_2, -A_ROT_1) = cpy(right);

	rot_32(left, right);
}

fn line = (t2, t1, t0) => color { color = 1; COL_4 = 1; DIE = on(t2, t1, t0); }

ant 0x9 { COL_2 = line(1, 1, 0); }
ant 0xa { COL_1 = line(1, 1, 0); }
ant 0xc { COL_1 = line(1, 1, 0); }
ant 0xe { COL_1 = line(1, 1, 0); }

ant mouth = 0xb {
	COL_4 = 1;
	(MEM_0, COL_0, -COL_1) = cpy(or(MEM_0, CTR_2));
	(A_ID_0, DIE) = cpy(on(1, 1, 1));
}

ant eyes = 0xd {
	COL_4 = 1;
	(t0, t1, t2, t3, t4, t5, t6, t7) = dec(CTR_2, CTR_1, CTR_0);
	green = or(t0, t1, t7);
	white = or(t2, t4, t5);
	COL_1 = or(white, green);
	(COL_3, COL_2, COL_0) = cpy(white);
	DIE = t7;
}

ant ears = 0xf {
	(COL_4, COL_1) = cpy(and(
		-INL,
		line(1, 1, 1),
		or(one(CTR_2, CTR_1, CTR_0), on(1, 0, 1))
	));
}
