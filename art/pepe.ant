set start = bottom_left;
set height = 12;
set width = 20;
set border = obs;
set layers = 2;
set speed = 2;
set fps = 6;
# set fps = 2;

ant queen = 0 {
	(A3, AR0, AR1) = cpy(on(0, 0, 1, 1));
	(A1, A0, D, ) = cpy(on(1, 1, 1, 0));
}

ant clk = 3 { H = 1; S0 = C0; S1 = C14; }

ant cig = 1 {
	AM0 = B; AM2 = C2; AM1 = -or(AM0, AM2); D = AM2;
	(A1, AR0, AR1) = cpy(1);
}

ant cig_part = 2 {
	TB = 1;

	(move, -H, R0) = cpy(S1);
	(is_up, M3) = cpy(xor(M3, S1));

	filter = M0;
	core = M1;
	(brown, white, gray) = fwd_and(-move, M0, M1, M2);

	T3 = white; T2 = or(white, gray); T1 = or(white, brown, gray);
	T0 = or(T1, and(move, filter, is_up));
	T4 = or(T3, T2, T1, T0);

	(A2, AA, AR0, AR1) = cpy(and(core, is_up, -move));
}

ant smoke = 4 {
	D = or(S2, and(V, -VA2));
	keep = T4;
	paint = and(-D, S0, -keep);

	H = S0;
	T3 = or(paint, and(keep, T0));

	turn = N0;
	R1 = turn;
	R0 = and(-M0, turn);
	M0 = xor(M0, turn);
}

ant frog = 0x8 {
	H = B;
	D = C3;

	right = or(on(0, 1, 1), on(1, 0, 1));
	left =  or(on(1, 0, 0), on(1, 1, 0));
	
	A3 = and(-B, -D);
	(A2, A1, A0) = fwd_and(A3, C2, C1, C0);
	(AR2, -AR1) = cpy(right);

	() = rotd(left, right);
}

fn line = (c2, c1, c0) => color { color = 1; T4 = 1; D = on(c2, c1, c0); }

ant 0x9 { T2 = line(1, 1, 0); }
ant 0xa { T1 = line(1, 1, 0); }
ant 0xc { T1 = line(1, 1, 0); }
ant 0xe { T1 = line(1, 1, 0); }

ant mouth = 0xb {
	T4 = 1;
	(M0, T0, -T1) = cpy(or(M0, C2));
	(A0, D) = cpy(on(1, 1, 1));
}

ant eyes = 0xd {
	T4 = 1;
	(c0, c1, c2, c3, c4, c5, c6, c7) = dec(C2, C1, C0);
	green = or(c0, c1, c7);
	white = or(c2, c4, c5);
	T1 = or(white, green);
	(T3, T2, T0) = cpy(white);
	D = c7;
}

ant ears = 0xf {
	(T4, T1) = cpy(and(
		-B,
		line(1, 1, 1),
		or(one(C2, C1, C0), on(1, 0, 1))
	));
}
