set start = bottom_left;
set height = 12;
set width = 20;
set border = obs;
set layer_limit = 2;
set speed = 2;
set fps = 6;
# set fps = 2;

ant queen = 0 {
	(A_ID3, A_ROT0, A_ROT1) = cpy(on(0, 0, 1, 1));
	(A_ID1, A_ID0, DIE, ) = cpy(on(1, 1, 1, 0));
}

ant clk = 3 { HLT = 1; SIG0 = CTR0; SIG1 = EVR4; }

ant cig = 1 {
	A_MEM0 = INL; A_MEM2 = CTR2; A_MEM1 = -or(A_MEM0, A_MEM2); DIE = A_MEM2;
	(A_ID1, A_ROT0, A_ROT1) = cpy(1);
}

ant cig_part = 2 {
	TBK = 1;

	(move, -HLT, ROT0) = cpy(SIG1);
	(is_up, MEM3) = cpy(xor(MEM3, SIG1));

	filter = MEM0;
	core = MEM1;
	(brown, white, gray) = fwd_and(-move, MEM0, MEM1, MEM2);

	COL3 = white; COL2 = or(white, gray); COL1 = or(white, brown, gray);
	COL0 = or(COL1, and(move, filter, is_up));
	COL4 = or(COL3, COL2, COL1, COL0);

	(A_ID2, A_LYR, A_ROT0, A_ROT1) = cpy(and(core, is_up, -move));
}

ant smoke = 4 {
	DIE = or(SIG2, and(N_OBS, -N_ID2));
	keep = COL4;
	paint = and(-DIE, SIG0, -keep);

	HLT = SIG0;
	COL3 = or(paint, and(keep, COL0));

	turn = RND0;
	ROT1 = turn;
	ROT0 = and(-MEM0, turn);
	MEM0 = xor(MEM0, turn);
}

ant frog = 0x8 {
	HLT = INL;
	DIE = CTR3;

	right = or(on(0, 1, 1), on(1, 0, 1));
	left =  or(on(1, 0, 0), on(1, 1, 0));
	
	A_ID3 = and(-INL, -DIE);
	(A_ID2, A_ID1, A_ID0) = fwd_and(A_ID3, CTR2, CTR1, CTR0);
	(A_ROT2, -A_ROT1) = cpy(right);

	rot_32(left, right);
}

fn line = (t2, t1, t0) => color { color = 1; COL4 = 1; DIE = on(t2, t1, t0); }

ant 0x9 { COL2 = line(1, 1, 0); }
ant 0xa { COL1 = line(1, 1, 0); }
ant 0xc { COL1 = line(1, 1, 0); }
ant 0xe { COL1 = line(1, 1, 0); }

ant mouth = 0xb {
	COL4 = 1;
	(MEM0, COL0, -COL1) = cpy(or(MEM0, CTR2));
	(A_ID0, DIE) = cpy(on(1, 1, 1));
}

ant eyes = 0xd {
	COL4 = 1;
	(t0, t1, t2, t3, t4, t5, t6, t7) = dec(CTR2, CTR1, CTR0);
	green = or(t0, t1, t7);
	white = or(t2, t4, t5);
	COL1 = or(white, green);
	(COL3, COL2, COL0) = cpy(white);
	DIE = t7;
}

ant ears = 0xf {
	(COL4, COL1) = cpy(and(
		-INL,
		line(1, 1, 1),
		or(one(CTR2, CTR1, CTR0), on(1, 0, 1))
	));
}
