set size = 8;
set start = top_left;
set border = wrap;
set speed = 64;
set fps = 24;
set fg = none;

fn main = (y2, y1, y0, x2, x1, x0) => () {
	black = or(
		and(
			or(
				p_eq(y2, y1, y0, 0, 0, 1),
				p_eq(y2, y1, y0, 0, 1, 0)
			),
			or(
				p_eq(x2, x1, x0, 0, 0, 1),
				p_eq(x2, x1, x0, 0, 1, 0),
				p_eq(x2, x1, x0, 1, 0, 1),
				p_eq(x2, x1, x0, 1, 1, 0)
			)
		),

		and(
			p_eq(y2, y1, y0, 0, 1, 1),
			or(
				p_eq(x2, x1, x0, 0, 1, 1),
				p_eq(x2, x1, x0, 1, 0, 0)
			)
		),

		and(
			or(
				p_eq(y2, y1, y0, 1, 0, 0),
				p_eq(y2, y1, y0, 1, 0, 1)
			),
			or(
				p_eq(x2, x1, x0, 0, 1, 0),
				p_eq(x2, x1, x0, 0, 1, 1),
				p_eq(x2, x1, x0, 1, 0, 0),
				p_eq(x2, x1, x0, 1, 0, 1)
			)
		),

		and(
			p_eq(y2, y1, y0, 1, 1, 0),
			or(
				p_eq(x2, x1, x0, 0, 1, 0),
				p_eq(x2, x1, x0, 1, 0, 1)
			)
		)
	);

	red = and(
		p_eq(y2, y1, y0, 0, 1, 0), 
		or(
			p_eq(x2, x1, x0, 0, 1, 0),
			p_eq(x2, x1, x0, 1, 0, 1),
		),
	);

	COL0 = red;
	COL1 = -or(red, black);
	COL3 = or(red, and(-black, RND0));

	COL4 = black;
}

ant 0 {
	main(CTR5, CTR4, CTR3, CTR2, CTR1, CTR0);
}
