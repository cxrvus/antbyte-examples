set size = 64;
set start = left;
set border = wrap;
set bg_filter = bin;
set speed = 32;

fn dir_change = (mem, clock) => (mem_out, dir) {
	dir = xor(mem, clock);
	mem_out = clock;
}

ant main = 1 {
	CLR = 1;
	COL0 = -COL0;

	(MEM2, ROT1) = dir_change(MEM2, CTR2);
	(MEM3, ROT0) = dir_change(MEM3, CTR3);
	(MEM7, ROT2) = dir_change(MEM7, CTR7);
}
