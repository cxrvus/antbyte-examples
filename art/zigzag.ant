set size = 64;
set start = left;
set border = wrap;
set bg_filter = bin;
set speed = 32;

fn dir_change = (mem, clock) => (mem_out, dir) {
	dir = xor(mem, clock);
	mem_out = clock;
}

ant main = 1 {
	CZ = 1;
	C0 = -C0;

	(M2, R1) = dir_change(M2, T2);
	(M3, R0) = dir_change(M3, T3);
	(M7, R2) = dir_change(M7, T7);
}
