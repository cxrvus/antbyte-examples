set start_pos = left;
set start_dir = "S";
set height = 32;
set width = 40;
set border = obs;
set fps = 12;
set loop;
set speed = 8;
set layer_limit = 2;
set layer_filter = 0b10;
set fg = none;

# set start_tick = 500;
# set fps = 1;

ant queen = 0 {
	HLT = MEM0;
	MEM0 = or(MEM0, CTR1);
	(A_ID1, A_LYR, A_ROT1, A_ROT0) = cpy(-MEM0);

	SIG0 = -MEM0;
	SIG1 = and(MEM0, PRB4);
	SIG2 = -CTR0;

	DIE = and(MEM0, -SIG3);
}

ant queen2 = 2 {
	SIG3 = 1;
	HLT = SIG0;
	(DIE, A_ID1, A_ID0) = cpy(-SIG0);
}

ant cig_spawner = 3 {
	SIG3 = 1;
	A_ID2 = -MEM0;
	A_ID3 = +MEM0;
	MEM0 = or(MEM0, CTR2);
	DIE = on(0, 1, 1, 0, 0, 0);
}

ant filter = 4 {
	SIG3 = 1;

	DIE = and(OBS, -N_ID3, -N_ID2, -N_ID1);
	HLT = or(-MEM0, SIG2);
	(COL1, COL0) = cpy(and(HLT, -DIE));

	ROT1 = and(-MEM0, SIG4);
	MEM0 = or(MEM0, SIG4);
	SIG4 = -OBS;
}

ant cig = 8 {
	HLT = 1;
			
	ROT0 = -OBS;
	MEM0 = or(MEM0, -OBS);
	lit = MEM0;

	(A_ID3, A_ID2, A_ROT0) = cpy(lit);

	MEM1 = xor(MEM1, PRB2);
	A_MEM1 = MEM1;

	(COL3, COL0) = cpy(1);
	COL2 = -lit;
	COL1 = and(lit, PRB2);

	DIE = or(and(lit, SIG1), N_ID2);
	(COL3, COL2, COL1, COL0) = fwd_and(-DIE, COL3, COL2, COL1, COL0);
}

ant smoke = 12 {
	SIG3 = 1;

	DIE = and(OBS, -N_ID3);
	paint = and(-DIE, SIG2);
	HLT = paint;
	(COL3, COL2, COL1, COL0) = fwd_and(paint, -MEM1, MEM1, MEM1, MEM1);

	turn = RND0;
	ROT1 = turn;
	ROT0 = and(-MEM0, turn);
	MEM0 = xor(MEM0, turn);
}
