set fps = 24;
set speed = 4;
# set size = 32;
set start = top_left;
set start_dir = 4;
set layers = 2;
set main_layer = 1;

## Debug
# set { fps = 1; speed = 1; }
set start_tick = 256;
set fg = id;

## Release
# set { bg_filter = bin; }

ant queen = 0 {
	H = 1; C4 = 1;
	AA = 1; AD2 = 1;

	A4 = J;
	A1 = and(-J, -S0, -M0);
	A2 = and(-J, -S0, +M0);
	M0 = and(-J, xor(M0, -S0));

	# signal delay
	W0 = or(A1, A2, A4);
}

fn worker = () => () { S0 = 1; Z = C4; }

ant randomizer = 0b10000 {
	() = worker();
	C1 = RR1;
} 

# TODO
ant cell_marker = 2 {
	() = worker();
	C2 = -C2;
}

# TODO
ant cell_handler = 4 {
	() = worker();
	C3 = -C3;
}
