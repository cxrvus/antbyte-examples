cfg {
	fps = 30;
	# fps = 4;
	start_tick = 300;
	speed = 16;
	keys = "465";
	size = 128;
	loop;
	sleep = 2000;
	start_pos = top_right;
	start_dir = 4;
	fg = none;
	euclid;
}

cfg {
	border_0 = obs; 	# default: queen, UI
	border_1 = die;		# snake, snake spawner
	border_2 = cycle;	# enemy spawner
	border_3 = cycle;	# enemies
}

lnk {
	spawn_chance(PRB_10);
}

ant queen = 0 {
	HLT = -INL;
	(-spawn_snake, spawn_ui) = cpy(CTR);
	(A_ROT_2, A_LFT, A_ID_1, A_LYR) = cpy(spawn_snake);
	(DIE, A_ID_2) = cpy(spawn_ui);
}

lnk snake_alive(SIG_0);

ant snake_spawner = 2 {
	snake_alive(1);

	spawn_enemies = and(-INL, -CLK_5, CLK_4);
	spawn_snake = and(-INL, CLK_5);

	DIE = spawn_snake;
	(A_ID_1:0) = cpy(or(spawn_snake, spawn_enemies));
	(A_ID_2, A_LYR) = cpy(spawn_enemies);
}

lnk can_brake(SIG_1);

ant snake = 3 {
	snake_alive(1);


	(DCY_13:2) = cpy(1);
	LFT = X_IN_0;
	DIE = N_COL_3;
	break = and(X_IN_2, can_brake());
	HLT = mux(break,, -CLK_3, -CLK_4);

	(ROT_7:6) = cpy(and(
		or(-HLT, CLK_2),
		or(X_IN_1:0)
	));

	COL_3 = -break;
	COL_1 = 1;
}

ant ui_end = 4 {
	(A_ID_2:1, A_ROT_0) = cpy(INL);
	COL_2 = 1;
	COL_3 = 1;
	DIE = OBS;
}

ant ui = 6 {
	HLT = -CLK_2;
	RST = 1;
	brake = X_IN_2;
	(ROT_0, -COL_2, -COL_3) = cpy(brake);
	DIE = -snake_alive();
	can_brake(-and(brake, OBS));
}

ant enemy_spawner = 7 {
	A_LYR = 1;
	(LFT, ROT_6:4) = fwd(RND_3:0);
	spawn = and(spawn_chance(), -COL_3);
	(enemy_id_1:0) = fwd(RND_5:4);
	(A_ID_3:0) = fwd_and(spawn, 1, 0, enemy_id_1:0);
	DIE = -snake_alive();
}

def enemy() => (col, dcy, hlt, die) {
	COL_3 = 1;
	col = 1;
	dcy = 1;
    hlt = -CLK_3;
	die = or(N_COL_3, -snake_alive());
}

ant worm = 8 {
	COL_4 = 1;
	(COL_2, DCY_12, HLT, DIE) = enemy();

	DIE = and(DIE, -N_COL_4);

    ROT_5 = HLT;
    ROT_7 = and(or(N_COL_73, N_COL_13), HLT);
    ROT_2 = and(or(OBS, N_COL_3), -HLT);

    LFT = or(
		and(HLT, RND),
		and(N_COL_13, -HLT)
	); 
}

ant laser = 9 {
	(COL_0, DCY_13, _hlt, DIE) = enemy();

	SLP_3 = 1;
	DIE = or(DIE, CTR_7);
}

ant maggot_spawner = 10 {
	A_LFT = RND_0;
	A_ROT_1 = 1;
	A_ID_5 = CLK_3;
	DIE = CTR_6;
}

ant maggot = 32 {
	(_col, DCY_12, HLT, DIE) = enemy();

	ROT_5 = RND_0;
	LFT = RND_1;
	DIE = or(DIE, CTR_7);
	SLP_4 = 1;
}
