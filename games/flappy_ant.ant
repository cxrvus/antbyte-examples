set start = left;
set keys = " ";
set fps = 20;
set { height = 32; width = 64; }

set bg = id;
set fg = id;
set fg = none;
set start_tick = 100;

set layers = 2;
set border = obs;

ant queen = 0x00 {
	S0 = 1; # init

	(obs0, obs1, obs2, obs3) = dec(M1, M0);
	last = M2;

	(A1, A0) = cpy(B);
	(A6, AR0) = cpy(and(V, obs0));	# blockade_spawner
	(A7, AA) = cpy(and(V, obs2));	# god
	(A5) = cpy(last);				# pipe_spawner
	A4 = or(A6, A5);
	AR1 = 1;

	D = and(last, VM47);

	R1 = and(V, or(obs1, obs2));
	H = or(last, and(V, obs0));
	
	# state
	(cout, M1, M0) = add(M1, M0, 0, V);
	last = or(last, and(M1, M0));
	M2 = last;
}

ant bird = 0x03 {
	S7 = 1;
	TB = 1;

	H = or(S0, C0);
	D = or(and(V, -M1), VA5);	# die when hitting floor or pipe
	(A4, A1, A0) = cpy(D);		# spawn ghost

	R0 = and(-S0, xor(M0, X0));
	M0 = and(-S0, X0);
	M1 = xor(M1, R0);
}

ant bird_ghost = 0x13 {
	K = N; TB = 1;
	R1 = or(N13, and(V, -VA5, M0));
	(A4, A1, A0) = cpy(or(X0, N15));
	M0 = V;
}

ant pipe = 0x22 { 
	(D, K) = cpy(and(S7, V, -VA5));
	K = 0;
	R1 = and(-S7, N13, C13);		# random movement after bird death
}

ant pipe2 = 0x2a { () = pipe(); }

ant pipe_spawner = 0x30 {
	D = -S7;

	spawn = and(S7, -S0, S3);
	(A5, A1, AR0) = cpy(spawn);
	A3 = and(spawn, or(VA36, VA56));

	R1 = and(-M0, -S0);
	M0 = -S0;
	
	M7 = 1; 		# for queen
}

ant blockade = 0x40 {
	D = -S7;
	R0 = S1;
	H = or(S0, S2, S3);
}

ant blockade_spawner = 0x50 {
	A6 = 1;
	H = -C3;
	D = C4;
}

ant god = 0x80 {
	H = 1;
	S1 = N13;
	S2 = N11;
	S3 = and(C4, C3, C2);
}
