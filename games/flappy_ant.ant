set start = left;
set keys = " ";
set fps = 20;
set { height = 32; width = 64; }

set bg = id;
set fg = id;
set fg = none;
set start_tick = 100;

set layer_limit = 2;
set border = obs;

ant queen = 0x00 {
	SIG_0 = 1; # init

	(obs0, obs1, obs2, obs3) = dec(MEM_1, MEM_0);
	last = MEM_2;

	(A_ID_1, A_ID_0) = cpy(INL);
	(A_ID_6, A_ROT_0) = cpy(and(OBS, obs0));	# blockade_spawner
	(A_ID_7, A_LYR) = cpy(and(OBS, obs2));	# god
	(A_ID_5) = cpy(last);				# pipe_spawner
	A_ID_4 = or(A_ID_6, A_ID_5);
	A_ROT_1 = 1;

	DIE = and(last, N_MEM_47);

	ROT_1 = and(OBS, or(obs1, obs2));
	HLT = or(last, and(OBS, obs0));
	
	# state
	(cout, MEM_1, MEM_0) = add(MEM_1, MEM_0, 0, OBS);
	last = or(last, and(MEM_1, MEM_0));
	MEM_2 = last;
}

ant bird = 0x03 {
	SIG_7 = 1;
	TBK = 1;

	HLT = or(SIG_0, CTR_0);
	DIE = or(and(OBS, -MEM_1), N_ID_5);	# die when hitting floor or pipe
	(A_ID_4, A_ID_1, A_ID_0) = cpy(DIE);		# spawn ghost

	ROT_0 = and(-SIG_0, xor(MEM_0, X_IN_0));
	MEM_0 = and(-SIG_0, X_IN_0);
	MEM_1 = xor(MEM_1, ROT_0);
}

ant bird_ghost = 0x13 {
	KLL = RND; TBK = 1;
	ROT_1 = or(PRB_3, and(OBS, -N_ID_5, MEM_0));
	(A_ID_4, A_ID_1, A_ID_0) = cpy(or(X_IN_0, PRB_5));
	MEM_0 = OBS;
}

ant pipe = 0x22 { 
	(DIE, KLL) = cpy(and(SIG_7, OBS, -N_ID_5));
	KLL = 0;
	ROT_1 = and(-SIG_7, PRB_3, CLK_3);		# random movement after bird death
}

ant pipe2 = 0x2a { pipe(); }

ant pipe_spawner = 0x30 {
	DIE = -SIG_7;

	spawn = and(SIG_7, -SIG_0, SIG_3);
	(A_ID_5, A_ID_1, A_ROT_0) = cpy(spawn);
	A_ID_3 = and(spawn, or(N_ID_36, N_ID_56));

	ROT_1 = and(-MEM_0, -SIG_0);
	MEM_0 = -SIG_0;
	
	MEM_7 = 1; 		# for queen
}

ant blockade = 0x40 {
	DIE = -SIG_7;
	ROT_0 = SIG_1;
	HLT = or(SIG_0, SIG_2, SIG_3);
}

ant blockade_spawner = 0x50 {
	A_ID_6 = 1;
	HLT = -CTR_3;
	DIE = CTR_4;
}

ant god = 0x80 {
	HLT = 1;
	SIG_1 = PRB_3;
	SIG_2 = PRB_1;
	SIG_3 = and(CTR_4, CTR_3, CTR_2);
}
