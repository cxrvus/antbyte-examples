set size = 16;
set layer_limit = 4;
set border_0 = cycle;
set border_1 = wrap;

set keys = "wasdr";
set loop;
set start_tick = 64;
set fg = none;

# set fg = layers;
# set fg = id;
# set layer_filter = 0b1;
# set fps = 1;


ant queen = 0 {
	SIG0 = 1; # initialization phase

	A_ID2 = on(0, 0, 0); # tail
	A_ID1 = on(1, 1, 0); # head
	A_ID3 = on(1, 1, 1); # food spawner

	# score
	A_ID4 = or(on(0, 0, 1), on(0, 1, 0));
	A_ID0 = and(A_ID4, on(0, 1, 0));

	# stop spawning after A_ID3
	(A_ID4, A_ID3, A_ID2, A_ID1, A_ID0) = fwd_and(-MEM0, A_ID4, A_ID3, A_ID2, A_ID1, A_ID0);
	HLT = MEM0;
	MEM0 = or(MEM0, A_ID3);

	# stop painting after A_ID1
	MEM1 = or(MEM1, A_ID1);
	paint = -MEM1;
	(COL5, COL1) = cpy(paint);

	A_LYR0 = or(A_ID4, A_ID3); A_LYR1 = A_ID4;

	DIE = CTR6;	# head start for food spawner
}

fn score = (incr, m3i, m2i, m1i, m0i) => (cout, m3o, m2o, m1o, m0o, y3, y2, y1, y0) {
	HLT = 1;

	# scoring
	(cout, m0o) = add(m0i, incr);
	(cout, m1o) = add(cout, m1i);
	(cout, m2o) = add(cout, m2i);
	(cout, m3o) = add(cout, m3i);
	(y3, y2, y1, y0) = fwd(m3o, m2o, m1o, m0o);

	SIG7 = SIG7; 	# game over
	(A_ID4, A_ID1, A_ROT0) = cpy(SIG7);
	DIE = and(SIG7, X_IN4);		# restart by pressing RND
}

ant score_lsb = 16 { # @layer = 3
	incr = and(SIG2, -SIG0);
	(cout, MEM3, MEM2, MEM1, MEM0, X_OUT3, X_OUT2, X_OUT1, X_OUT0) = score(incr, MEM3, MEM2, MEM1, MEM0);
	SIG3 = cout;
}

ant score_msb = 17 { # @layer = 3
	incr = SIG3;
	(_win, MEM7, MEM6, MEM5, MEM4, X_OUT7, X_OUT6, X_OUT5, X_OUT4) = score(incr, MEM7, MEM6, MEM5, MEM4);
}

ant game_over = 18 { DIE = X_IN4; COL0 = and(CLR, xor(COL0, CTR3)); }

ant head = 2 {
	DIE = and(-SIG0, COL5);	# die on intersection
	SIG7 = DIE;				# game over on death

	HLT = SIG0;
	SLP3 = -SIG0;
	(COL5, COL1) = cpy(-SIG0);

	COL4 = 0; # eat food

	## WASD movement
	# todo: extract to module
	w0 = and(+MEM2, +MEM1);
	a0 = and(+MEM2, -MEM1);
	s0 = and(-MEM2, +MEM1);
	d0 = and(-MEM2, -MEM1);

	w1 = X_IN0; a1 = X_IN1; s1 = X_IN2; d1 = X_IN3;
	# todo: assert uniqueness

	right = or(
		and(w0, d1), and(d0, s1), and(s0, a1), and(a0, w1),
	);
	left = or(
		and(w0, a1), and(a0, s1), and(s0, d1), and(d0, w1),
	);

	(r0, r1) = rot_64(left, right);
	(COL7, COL6) = fwd(r0, r1);

	# remember rotation
	(cout, MEM1) = add(MEM1, r1);
	(cout, MEM2) = add(cout, MEM2, r0);
}

ant tail = 4 {
	DIE = SIG7;

	HLT = or(COL3, SIG0);
	SLP3 = -SIG0;
	(COL5, COL1) = cpy(HLT);
	COL3 = 0;

	(ROT0, ROT1) = fwd(COL7, COL6);
	(COL7, COL6) = cpy(0);
}

ant food_spawner = 8 { # @layer = 1
	DIE = SIG7;

	# random movement
	HLT = PRB2;
	turn = PRB3;
	MEM2 = xor(MEM2, turn);
	(right, -left) = cpy(MEM2);
	ROT1 = and(turn, or(right, left));
	ROT0 = and(turn, left);

	spawn = and(-SIG1, -SIG0, -MEM0, -COL5);
	(A_ID3, A_ID0, A_LYR0) = cpy(spawn);
	MEM0 = spawn;	# signal delay
}

ant food = 9 { # @layer = 2;
	HLT = 1;
	SIG1 = 1;
	score = and(-INL, -COL4);
	(SIG2, COL3) = cpy(+score); # score upon being eaten
	(COL4, COL0) = cpy(-score);
	DIE = or(score, SIG7);
	COL1 = 1;
}
