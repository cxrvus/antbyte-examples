set size = 16;
set layer_limit = 4;
set border_0 = cycle;
set border_1 = wrap;

set keys = "wasdr";
set loop;
set start_tick = 64;
set fg = none;

# set fg = layers;
# set fg = id;
# set layer_filter = 0b1;
# set fps = 1;


ant queen = 0 {
	SIG_0 = 1; # initialization phase

	A_ID_2 = on(0, 0, 0); # tail
	A_ID_1 = on(1, 1, 0); # head
	A_ID_3 = on(1, 1, 1); # food spawner

	# score
	A_ID_4 = or(on(0, 0, 1), on(0, 1, 0));
	A_ID_0 = and(A_ID_4, on(0, 1, 0));

	# stop spawning after A_ID_3
	(A_ID_4, A_ID_3, A_ID_2, A_ID_1, A_ID_0) = fwd_and(-MEM_0, A_ID_4, A_ID_3, A_ID_2, A_ID_1, A_ID_0);
	HLT = MEM_0;
	MEM_0 = or(MEM_0, A_ID_3);

	# stop painting after A_ID_1
	MEM_1 = or(MEM_1, A_ID_1);
	paint = -MEM_1;
	(COL_5, COL_1) = cpy(paint);

	A_LYR_0 = or(A_ID_4, A_ID_3); A_LYR_1 = A_ID_4;

	DIE = CTR_6;	# head start for food spawner
}

fn score = (incr, m3i, m2i, m1i, m0i) => (cout, m3o, m2o, m1o, m0o, y3, y2, y1, y0) {
	HLT = 1;

	# scoring
	(cout, m0o) = add(m0i, incr);
	(cout, m1o) = add(cout, m1i);
	(cout, m2o) = add(cout, m2i);
	(cout, m3o) = add(cout, m3i);
	(y3, y2, y1, y0) = fwd(m3o, m2o, m1o, m0o);

	SIG_7 = SIG_7; 	# game over
	(A_ID_4, A_ID_1, A_ROT_0) = cpy(SIG_7);
	DIE = and(SIG_7, X_IN_4);		# restart by pressing RND
}

ant score_lsb = 16 { # @layer = 3
	incr = and(SIG_2, -SIG_0);
	(cout, MEM_3, MEM_2, MEM_1, MEM_0, X_OUT_3, X_OUT_2, X_OUT_1, X_OUT_0) = score(incr, MEM_3, MEM_2, MEM_1, MEM_0);
	SIG_3 = cout;
}

ant score_msb = 17 { # @layer = 3
	incr = SIG_3;
	(_win, MEM_7, MEM_6, MEM_5, MEM_4, X_OUT_7, X_OUT_6, X_OUT_5, X_OUT_4) = score(incr, MEM_7, MEM_6, MEM_5, MEM_4);
}

ant game_over = 18 { DIE = X_IN_4; COL_0 = and(CLR, xor(COL_0, CTR_3)); }

ant head = 2 {
	DIE = and(-SIG_0, COL_5);	# die on intersection
	SIG_7 = DIE;				# game over on death

	HLT = SIG_0;
	SLP_3 = -SIG_0;
	(COL_5, COL_1) = cpy(-SIG_0);

	COL_4 = 0; # eat food

	## WASD movement
	# todo: extract to module
	w0 = and(+MEM_2, +MEM_1);
	a0 = and(+MEM_2, -MEM_1);
	s0 = and(-MEM_2, +MEM_1);
	d0 = and(-MEM_2, -MEM_1);

	w1 = X_IN_0; a1 = X_IN_1; s1 = X_IN_2; d1 = X_IN_3;
	# todo: assert uniqueness

	right = or(
		and(w0, d1), and(d0, s1), and(s0, a1), and(a0, w1),
	);
	left = or(
		and(w0, a1), and(a0, s1), and(s0, d1), and(d0, w1),
	);

	(r0, r1) = rot_64(left, right);
	(COL_7, COL_6) = fwd(r0, r1);

	# remember rotation
	(cout, MEM_1) = add(MEM_1, r1);
	(cout, MEM_2) = add(cout, MEM_2, r0);
}

ant tail = 4 {
	DIE = SIG_7;

	HLT = or(COL_3, SIG_0);
	SLP_3 = -SIG_0;
	(COL_5, COL_1) = cpy(HLT);
	COL_3 = 0;

	(ROT_0, ROT_1) = fwd(COL_7, COL_6);
	(COL_7, COL_6) = cpy(0);
}

ant food_spawner = 8 { # @layer = 1
	DIE = SIG_7;

	# random movement
	HLT = PRB_2;
	turn = PRB_3;
	MEM_2 = xor(MEM_2, turn);
	(right, -left) = cpy(MEM_2);
	ROT_1 = and(turn, or(right, left));
	ROT_0 = and(turn, left);

	spawn = and(-SIG_1, -SIG_0, -MEM_0, -COL_5);
	(A_ID_3, A_ID_0, A_LYR_0) = cpy(spawn);
	MEM_0 = spawn;	# signal delay
}

ant food = 9 { # @layer = 2;
	HLT = 1;
	SIG_1 = 1;
	score = and(-INL, -COL_4);
	(SIG_2, COL_3) = cpy(+score); # score upon being eaten
	(COL_4, COL_0) = cpy(-score);
	DIE = or(score, SIG_7);
	COL_1 = 1;
}
