set size = 16;
set layers = 4;
set border_0 = cycle;
set border_1 = wrap;

set keys = "wasdr";
set looping = 1;
set start_tick = 64;
set fg = none;

# set fg = layers;
# set main_layer = 0;
# set fps = 1;


ant queen = 0 {
	S0 = 1; # initialization phase

	A2 = on(0, 0, 0); # tail
	A1 = on(1, 1, 0); # head
	A3 = on(1, 1, 1); # food spawner

	# score (x2)
	A4 = or(on(0, 0, 1), on(0, 1, 0));
	A0 = on(0, 1, 0);

	AA1 = A4;
	AA0 = or(A4, A3);
	Z = A3;

	paint = and(-A1, -A3);
	(C5, C1) = cpy(paint);
}

fn score = (incr, m3i, m2i, m1i, m0i) => (cout, m3o, m2o, m1o, m0o, x3, x2, x1, x0) {
	H = 1;

	# scoring
	(cout, m0o) = add(m0i, incr);
	(cout, m1o) = add(cout, m1i);
	(cout, m2o) = add(cout, m2i);
	(cout, m3o) = add(cout, m3i);
	(x3, x2, x1, x0) = buf(m3o, m2o, m1o, m0o);

	S7 = S7; 	# game over
	(A4, A1, AD2) = cpy(S7);
	Z = K4;		# restart by pressing R
}

ant score_lsb = 16 { # @layer = 3
	incr = and(S2, -S0);
	(cout, M3, M2, M1, M0, X3, X2, X1, X0) = score(incr, M3, M2, M1, M0);
	S3 = cout;
}

ant score_msb = 17 { # @layer = 3
	incr = S3;
	(_win, M7, M6, M5, M4, X7, X6, X5, X4) = score(incr, M7, M6, M5, M4);
}

ant game_over = 18 { Z = K4; C0 = xor(C0, RR2); }

ant head = 2 {
	Z = and(-S0, C5);	# die on intersection
	S7 = Z;				# game over on death

	H = S0;
	W3 = -S0;
	(C5, C1) = cpy(-S0);

	C4 = 0; # eat food

	## WASD movement
	# todo: extract to module
	w0 = and(+M2, +M1);
	a0 = and(+M2, -M1);
	s0 = and(-M2, +M1);
	d0 = and(-M2, -M1);

	w1 = K0; a1 = K1; s1 = K2; d1 = K3;
	# todo: assert uniqueness

	right = or(
		and(w0, d1), and(d0, s1), and(s0, a1), and(a0, w1),
	);
	left = or(
		and(w0, a1), and(a0, s1), and(s0, d1), and(d0, w1),
	);

	D1 = or(right, left); D2 = left;

	# remember direction
	(cout, M1) = add(M1, D1);
	(cout, M2) = add(cout, M2, D2);
}

ant tail = 4 {
	H = or(C3, S0);
	W3 = -S0;
	C1 = H;
	C5 = H;
	C3 = 0;

	turn =  and(-VC05, -H);
	right = and(turn, VC25);
	left =  and(turn, VC65);

	# Error
	(C2, Z) = cpy(and(turn, -VC25, -VC65));

	Z = or(Z, S7);

	D1 = or(right, left); D2 = left;
}

ant food_spawner = 8 { # @layer = 1
	Z = S7;

	# random movement
	H = RR2;
	turn = RR3;
	M2 = xor(M2, turn);
	(right, -left) = cpy(M2);
	D1 = and(turn, or(right, left));
	D2 = and(turn, left);

	# head start
	M1 = or(M1, T6); 	# initialized
	S0 = -M1; 			# uninitialized

	# todo: check if occupied

	spawn = and(+M1, -M0, -S1);
	(A3, A0, AA0) = cpy(spawn);
	M0 = spawn;	# signal delay
}

ant food = 9 { # @layer = 2;
	H = 1;
	S1 = 1;
	score = and(-J, -C4);
	(S2, C3) = cpy(+score); # score upon being eaten
	(C4, C0) = cpy(-score);
	Z = or(score, S7);
	C1 = 1;
}
