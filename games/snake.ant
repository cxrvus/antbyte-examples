set size = 16;
set layers = 4;
set border_0 = cycle;
set border_1 = wrap;

set keys = "wasdr";
set loop;
set start_tick = 64;
set fg = none;

# set fg = layers;
# set fg = id;
# set layer_filter = 0b1;
# set fps = 1;


ant queen = 0 {
	S0 = 1; # initialization phase

	A2 = on(0, 0, 0); # tail
	A1 = on(1, 1, 0); # head
	A3 = on(1, 1, 1); # food spawner

	# score
	A4 = or(on(0, 0, 1), on(0, 1, 0));
	A0 = and(A4, on(0, 1, 0));

	# stop spawning after A3
	(A4, A3, A2, A1, A0) = fwd_and(-M0, A4, A3, A2, A1, A0);
	H = M0;
	M0 = or(M0, A3);

	# stop painting after A1
	M1 = or(M1, A1);
	paint = -M1;
	(T5, T1) = cpy(paint);

	AA0 = or(A4, A3); AA1 = A4;

	D = C6;	# head start for food spawner
}

fn score = (incr, m3i, m2i, m1i, m0i) => (cout, m3o, m2o, m1o, m0o, y3, y2, y1, y0) {
	H = 1;

	# scoring
	(cout, m0o) = add(m0i, incr);
	(cout, m1o) = add(cout, m1i);
	(cout, m2o) = add(cout, m2i);
	(cout, m3o) = add(cout, m3i);
	(y3, y2, y1, y0) = fwd(m3o, m2o, m1o, m0o);

	S7 = S7; 	# game over
	(A4, A1, AR0) = cpy(S7);
	D = and(S7, X4);		# restart by pressing N
}

ant score_lsb = 16 { # @layer = 3
	incr = and(S2, -S0);
	(cout, M3, M2, M1, M0, Y3, Y2, Y1, Y0) = score(incr, M3, M2, M1, M0);
	S3 = cout;
}

ant score_msb = 17 { # @layer = 3
	incr = S3;
	(_win, M7, M6, M5, M4, Y7, Y6, Y5, Y4) = score(incr, M7, M6, M5, M4);
}

ant game_over = 18 { D = X4; T0 = and(E, xor(T0, C3)); }

ant head = 2 {
	D = and(-S0, T5);	# die on intersection
	S7 = D;				# game over on death

	H = S0;
	W3 = -S0;
	(T5, T1) = cpy(-S0);

	T4 = 0; # eat food

	## WASD movement
	# todo: extract to module
	w0 = and(+M2, +M1);
	a0 = and(+M2, -M1);
	s0 = and(-M2, +M1);
	d0 = and(-M2, -M1);

	w1 = X0; a1 = X1; s1 = X2; d1 = X3;
	# todo: assert uniqueness

	right = or(
		and(w0, d1), and(d0, s1), and(s0, a1), and(a0, w1),
	);
	left = or(
		and(w0, a1), and(a0, s1), and(s0, d1), and(d0, w1),
	);

	(r0, r1) = rot(left, right);
	(T7, T6) = fwd(r0, r1);

	# remember rotation
	(cout, M1) = add(M1, r1);
	(cout, M2) = add(cout, M2, r0);
}

ant tail = 4 {
	D = S7;

	H = or(T3, S0);
	W3 = -S0;
	(T5, T1) = cpy(H);
	T3 = 0;

	(R0, R1) = fwd(T7, T6);
	(T7, T6) = cpy(0);
}

ant food_spawner = 8 { # @layer = 1
	D = S7;

	# random movement
	H = N12;
	turn = N13;
	M2 = xor(M2, turn);
	(right, -left) = cpy(M2);
	R1 = and(turn, or(right, left));
	R0 = and(turn, left);

	spawn = and(-S1, -S0, -M0, -T5);
	(A3, A0, AA0) = cpy(spawn);
	M0 = spawn;	# signal delay
}

ant food = 9 { # @layer = 2;
	H = 1;
	S1 = 1;
	score = and(-B, -T4);
	(S2, T3) = cpy(+score); # score upon being eaten
	(T4, T0) = cpy(-score);
	D = or(score, S7);
	T1 = 1;
}
