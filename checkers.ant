set height = 8;
set width = 32;
set start = top_left;
set speed = 8;
set bg_filter = bin;
set border = obs;
set start_dir = 2;

ant main {
	C0 = -T0;

	# M0: V in previous tick
	# M1: last direction
	D1 = or(M0, V);
	D2 = and(D1, -M1);

	# toggle: toggle last direction
	toggle = and(M0, -V);
	M1 = xor(M1, toggle);

	M0 = and(-M0, V);

	Z = VC0;
}
