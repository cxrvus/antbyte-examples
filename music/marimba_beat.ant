use_cfg sp404_cfg;

set midi_out_ch_1 = 4;

set fps = 4;
set speed = 2;

set layers = 2;

set keys = "q";

ant 1 {
	(AA, A1) = cpy(J);

	X6 = 1;
	X0 = R0;
	X2 = R3;
	X3 = and (RR1, -X2);
	X4 = RR2;

	X11 = R7;
	X10 = R6;

	(C0, C1, C2, C3) = fwd(X0, X2, X3, X4);

	Z = K;
}

ant 2 {
	X0 = TT1;
	A2 = and(X0, RR3);
	H = 1;

	Z = K;
}

ant 4 {
	(X1, X0) = cpy(TT1);
	A3 = and(M, -TT1, RR3);
	Z = and(M, RR5);
	M = or(M, RR3);
	H = 1;
}

ant 8 {
	X1 = TT2;
	Z = -V;
	H = 1;
}
