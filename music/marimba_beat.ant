use_cfg sp404_cfg;

set midi_out_ch_1 = 4;

set fps = 4;
set speed = 2;

set layers = 2;

set keys = "q";

ant 1 {
	(AA, A1) = cpy(B);

	Y6 = 1;
	Y0 = N0;
	Y2 = N3;
	Y3 = and (N11, -Y2);
	Y4 = N12;

	Y11 = N7;
	Y10 = N6;

	(T0, T1, T2, T3) = fwd(Y0, Y2, Y3, Y4);

	D = X;
}

ant 2 {
	Y0 = C11;
	A2 = and(Y0, N13);
	H = 1;

	D = X;
}

ant 4 {
	(Y1, Y0) = cpy(C11);
	A3 = and(M, -C11, N13);
	D = and(M, N15);
	M = or(M, N13);
	H = 1;
}

ant 8 {
	Y1 = C12;
	D = -V;
	H = 1;
}
