use_cfg sp404_cfg;

set midi_out_ch_1 = 4;

set fps = 4;
set speed = 2;

set layer_limit = 2;

set keys = "q";

ant 1 {
	(A_LYR, A_ID_1) = cpy(INL);

	X_OUT_6 = 1;
	X_OUT_0 = RND_0;
	X_OUT_2 = RND_3;
	X_OUT_3 = and (PRB_1, -X_OUT_2);
	X_OUT_4 = PRB_2;

	X_OUT_11 = RND_7;
	X_OUT_10 = RND_6;

	(COL_0, COL_1, COL_2, COL_3) = fwd(X_OUT_0, X_OUT_2, X_OUT_3, X_OUT_4);

	DIE = X_IN;
}

ant 2 {
	X_OUT_0 = CLK_1;
	A_ID_2 = and(X_OUT_0, PRB_3);
	HLT = 1;

	DIE = X_IN;
}

ant 4 {
	(X_OUT_1, X_OUT_0) = cpy(CLK_1);
	A_ID_3 = and(MEM, -CLK_1, PRB_3);
	DIE = and(MEM, PRB_5);
	MEM = or(MEM, PRB_3);
	HLT = 1;
}

ant 8 {
	X_OUT_1 = CLK_2;
	DIE = -OBS;
	HLT = 1;
}
