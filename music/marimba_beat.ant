use_cfg sp404_cfg;

set midi_out_ch_1 = 4;

set fps = 4;
set speed = 2;

set layer_limit = 2;

set keys = "q";

ant 1 {
	(AA, A1) = cpy(B);

	Y6 = 1;
	Y0 = N0;
	Y2 = N3;
	Y3 = and (P1, -Y2);
	Y4 = P2;

	Y11 = N7;
	Y10 = N6;

	(T0, T1, T2, T3) = fwd(Y0, Y2, Y3, Y4);

	D = X;
}

ant 2 {
	Y0 = E1;
	A2 = and(Y0, P3);
	H = 1;

	D = X;
}

ant 4 {
	(Y1, Y0) = cpy(E1);
	A3 = and(M, -E1, P3);
	D = and(M, P5);
	M = or(M, P3);
	H = 1;
}

ant 8 {
	Y1 = E2;
	D = -V;
	H = 1;
}
