use_cfg sp404_cfg;

set start_pos = top_left;
set start_dir = "S";
set start_tick = 48;
set width = 16;
set height = 4;

set fps = 6;

set layer_limit = 3;
set layer_filter = 0b100;
set border_0 = die;
set border_1 = wrap;
set border_2 = cycle;

ant queen = 0 {
	spawn_song = 	on(0, 0, 0, 1);
	spawn_kick = 	on(0, 0, 1, 0);
	spawn_snare = 	on(0, 0, 1, 1);
	spawn_hi_hat = 	on(0, 1, 0, 0);

	HLT = or(spawn_song, spawn_kick);

	(A_ID1, A_ID0) = enc(spawn_song, spawn_kick, spawn_snare, spawn_hi_hat);
	(A_ID2, A_ID1, A_ID0) = add(A_ID1, A_ID0, 0, 1);
	(A_ID2, A_ID1, A_ID0) = fwd_and(-INL, A_ID2, A_ID1, A_ID0);
	(A_LYR0, -A_LYR1) = cpy(spawn_song);
	(A_ID3, A_ROT0, A_ROT1) = cpy(1);

	DIE = spawn_hi_hat;
}

fn play = (note_on, y1, y0) => () {
	HLT = or(SIG0, SIG1);
	(X_OUT1, X_OUT0) = fwd_and(and(-SIG0, -SIG1, note_on), y1, y0);
}

ant kick = 	0b1010 { play(-CLR, 0, 1); }
ant snare = 	0b1011 { play(-CLR, 1, 0); }

ant hi_hat = 	0b1100 {
	play(or(-CLR, RND0, RND1), 1, 1);
	(X_OUT13, X_OUT10) = cpy(CTR1);
}

ant song = 0b1001 {

	end = on(1, 1, 0, 0, 0, 0);
	MEM0 = or(MEM0, end);
	HLT = MEM0;

	SIG0 = -MEM0;			# init
	SIG1 = and(-SIG0, -CTR0);	# note-on

	kick = or(
		on(0, 0, 0, 0, 0, 0),
		on(0, 0, 0, 1, 0, 1),
		on(0, 0, 1, 0, 0, 0),
		on(0, 0, 1, 0, 0, 0),
		on(0, 0, 1, 1, 0, 1),
		on(0, 0, 1, 1, 1, 1),
	);
	snare = or(
		on(0, 1, 0, 0, 1, 0),
		on(0, 1, 0, 1, 1, 0),
		on(0, 1, 1, 0, 1, 0),
		on(0, 1, 1, 1, 1, 0),
	);
	hi_hat = or(
		on(1, 0, 0, 0, 0, 1),
		on(1, 0, 0, 0, 1, 1),
		on(1, 0, 0, 1, 0, 0),
		on(1, 0, 0, 1, 1, 1),
		on(1, 0, 1, 0, 0, 1),
		on(1, 0, 1, 0, 1, 1),
		on(1, 0, 1, 1, 0, 0),
	);

	(COL0, COL1, COL2) = fwd_and(SIG0, kick, snare, hi_hat);
}
