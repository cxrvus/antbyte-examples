use_cfg sp404_cfg;

set start_pos = top_left;
set start_dir = 2;
set start_tick = 48;
set width = 16;
set height = 4;

set fps = 6;

set layers = 3;
set layer_filter = 0b100;
set border_0 = die;
set border_1 = wrap;
set border_2 = cycle;

ant queen = 0 {
	spawn_song = 	on(0, 0, 0, 1);
	spawn_kick = 	on(0, 0, 1, 0);
	spawn_snare = 	on(0, 0, 1, 1);
	spawn_hi_hat = 	on(0, 1, 0, 0);

	H = or(spawn_song, spawn_kick);

	(A1, A0) = enc(spawn_song, spawn_kick, spawn_snare, spawn_hi_hat);
	(A2, A1, A0) = add(A1, A0, 0, 1);
	(A2, A1, A0) = fwd_and(-B, A2, A1, A0);
	(AA0, -AA1) = cpy(spawn_song);
	(A3, AR0, AR1) = cpy(1);

	Z = spawn_hi_hat;
}

fn play = (note_on, y1, y0) => () {
	H = or(S0, S1);
	(Y1, Y0) = fwd_and(and(-S0, -S1, note_on), y1, y0);
}

ant kick = 	0b1010 { () = play(-E, 0, 1); }
ant snare = 	0b1011 { () = play(-E, 1, 0); }

ant hi_hat = 	0b1100 {
	() = play(or(-E, N0, N1), 1, 1);
	(Y13, Y10) = cpy(C1);
}

ant song = 0b1001 {

	end = on(1, 1, 0, 0, 0, 0);
	M0 = or(M0, end);
	H = M0;

	S0 = -M0;			# init
	S1 = and(-S0, -C0);	# note-on

	kick = or(
		on(0, 0, 0, 0, 0, 0),
		on(0, 0, 0, 1, 0, 1),
		on(0, 0, 1, 0, 0, 0),
		on(0, 0, 1, 0, 0, 0),
		on(0, 0, 1, 1, 0, 1),
		on(0, 0, 1, 1, 1, 1),
	);
	snare = or(
		on(0, 1, 0, 0, 1, 0),
		on(0, 1, 0, 1, 1, 0),
		on(0, 1, 1, 0, 1, 0),
		on(0, 1, 1, 1, 1, 0),
	);
	hi_hat = or(
		on(1, 0, 0, 0, 0, 1),
		on(1, 0, 0, 0, 1, 1),
		on(1, 0, 0, 1, 0, 0),
		on(1, 0, 0, 1, 1, 1),
		on(1, 0, 1, 0, 0, 1),
		on(1, 0, 1, 0, 1, 1),
		on(1, 0, 1, 1, 0, 0),
	);

	(T0, T1, T2) = fwd_and(S0, kick, snare, hi_hat);
}
