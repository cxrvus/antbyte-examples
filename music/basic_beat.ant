use_cfg sp404_cfg;

set start_pos = top_left;
set start_dir = "S";
set start_tick = 48;
set width = 16;
set height = 4;

set fps = 6;

set layer_limit = 3;
set layer_filter = 0b100;
set border_0 = die;
set border_1 = wrap;
set border_2 = cycle;

ant queen = 0 {
	spawn_song = 	on(0, 0, 0, 1);
	spawn_kick = 	on(0, 0, 1, 0);
	spawn_snare = 	on(0, 0, 1, 1);
	spawn_hi_hat = 	on(0, 1, 0, 0);

	HLT = or(spawn_song, spawn_kick);

	(A_ID_1, A_ID_0) = enc(spawn_song, spawn_kick, spawn_snare, spawn_hi_hat);
	(A_ID_2, A_ID_1, A_ID_0) = add(A_ID_1, A_ID_0, 0, 1);
	(A_ID_2, A_ID_1, A_ID_0) = fwd_and(-INL, A_ID_2, A_ID_1, A_ID_0);
	(A_LYR_0, -A_LYR_1) = cpy(spawn_song);
	(A_ID_3, A_ROT_0, A_ROT_1) = cpy(1);

	DIE = spawn_hi_hat;
}

def play(note_on, y1, y0) {
	HLT = or(SIG_0, SIG_1);
	(X_OUT_1, X_OUT_0) = fwd_and(and(-SIG_0, -SIG_1, note_on), y1, y0);
}

ant kick = 	0b1010 { play(-CLR, 0, 1); }
ant snare = 	0b1011 { play(-CLR, 1, 0); }

ant hi_hat = 	0b1100 {
	play(or(-CLR, RND_0, RND_1), 1, 1);
	(X_OUT_13, X_OUT_10) = cpy(CTR_1);
}

ant song = 0b1001 {

	end = on(1, 1, 0, 0, 0, 0);
	MEM_0 = or(MEM_0, end);
	HLT = MEM_0;

	SIG_0 = -MEM_0;			# init
	SIG_1 = and(-SIG_0, -CTR_0);	# note-on

	kick = or(
		on(0, 0, 0, 0, 0, 0),
		on(0, 0, 0, 1, 0, 1),
		on(0, 0, 1, 0, 0, 0),
		on(0, 0, 1, 0, 0, 0),
		on(0, 0, 1, 1, 0, 1),
		on(0, 0, 1, 1, 1, 1),
	);
	snare = or(
		on(0, 1, 0, 0, 1, 0),
		on(0, 1, 0, 1, 1, 0),
		on(0, 1, 1, 0, 1, 0),
		on(0, 1, 1, 1, 1, 0),
	);
	hi_hat = or(
		on(1, 0, 0, 0, 0, 1),
		on(1, 0, 0, 0, 1, 1),
		on(1, 0, 0, 1, 0, 0),
		on(1, 0, 0, 1, 1, 1),
		on(1, 0, 1, 0, 0, 1),
		on(1, 0, 1, 0, 1, 1),
		on(1, 0, 1, 1, 0, 0),
	);

	(COL_0, COL_1, COL_2) = fwd_and(SIG_0, kick, snare, hi_hat);
}
