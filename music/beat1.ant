use_cfg sp404_cfg;

set start = top_left;
set fps = 3;

set layer_limit = 2;
set layer_filter = 0b10;

ant queen = 0 {
	HLT = 1;
	A_LYR = 1;
	A_ID_0 = INL;
	A_ID_1 = and(-A_ID_0, PRB_3);
}

ant 1 {
	# (X_OUT_3, X_OUT_2, X_OUT_1, X_OUT_0) = fwd(CTR_3, CTR_2, CTR_1, CTR_0);
	(X_OUT_3, X_OUT_2, X_OUT_1, X_OUT_0) = fwd(RND_3, 0, 0, RND_0);
	X_OUT_4 = RND_4;
	X_OUT_6 = 1;
	SLP_0 = 1;
}

ant 2 {
	X_OUT_0 = and(-SIG_1, CTR_0);
	X_OUT_1 = MEM_0;
	MEM_0 = X_OUT_0;
	SIG_1 = or(X_OUT_1, X_OUT_0);
	DIE = CTR_6;
}
