use_cfg sp404_cfg;

set start = top_left;
set fps = 3;

set layer_limit = 2;
set layer_filter = 0b10;

ant queen = 0 {
	HLT = 1;
	A_LYR = 1;
	A_ID0 = INL;
	A_ID1 = and(-A_ID0, PRB3);
}

ant 1 {
	# (X_OUT3, X_OUT2, X_OUT1, X_OUT0) = fwd(CTR3, CTR2, CTR1, CTR0);
	(X_OUT3, X_OUT2, X_OUT1, X_OUT0) = fwd(RND3, 0, 0, RND0);
	X_OUT4 = RND4;
	X_OUT6 = 1;
	SLP0 = 1;
}

ant 2 {
	X_OUT0 = and(-SIG1, CTR0);
	X_OUT1 = MEM0;
	MEM0 = X_OUT0;
	SIG1 = or(X_OUT1, X_OUT0);
	DIE = CTR6;
}
