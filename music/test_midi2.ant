set start = top_left;
set fps = 4;
set midi_out_ch = 5;

ant 0 {
	(X_OUT3, X_OUT2, X_OUT1, X_OUT0) = fwd(RND3, RND2, RND1, RND0);
	(COL3, COL2, COL1, COL0) = fwd(X_OUT3, X_OUT2, X_OUT1, X_OUT0);
	SLP = RND4;
	A_ID = RND5;
}

ant 1 {
	(X_OUT3, X_OUT2, X_OUT1, X_OUT0) = fwd(COL3, COL2, COL1, COL0);
	SLP1 = INL;
	DIE = -INL;
}
