use_cfg template;
set keys = "asdf";

ant 0 {
	(A_MEM_3, A_MEM_2, A_MEM_1, A_MEM_0) = fwd(X_IN_3, X_IN_2, X_IN_1, X_IN_0);
	A_ID_0 = or(X_IN_3, X_IN_2, X_IN_1, X_IN_0);
}

ant 1 {
	HLT = 1;

	(X_OUT_3, X_OUT_2, X_OUT_1, X_OUT_0) = fwd(MEM_3, MEM_2, MEM_1, MEM_0);
	(COL_3, COL_2, COL_1, COL_0) = fwd(X_OUT_3, X_OUT_2, X_OUT_1, X_OUT_0);
	(X_OUT_13, X_OUT_12) = fwd(CTR_1, CTR_0);
	SLP_0 = 1;
	DIE = and(CTR_1, CTR_0);
}
