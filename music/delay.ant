use_cfg template;
set keys = "asdf";

ant 0 {
	(A_MEM3, A_MEM2, A_MEM1, A_MEM0) = fwd(X_IN3, X_IN2, X_IN1, X_IN0);
	A_ID0 = or(X_IN3, X_IN2, X_IN1, X_IN0);
}

ant 1 {
	HLT = 1;

	(X_OUT3, X_OUT2, X_OUT1, X_OUT0) = fwd(MEM3, MEM2, MEM1, MEM0);
	(COL3, COL2, COL1, COL0) = fwd(X_OUT3, X_OUT2, X_OUT1, X_OUT0);
	(X_OUT13, X_OUT12) = fwd(CTR1, CTR0);
	SLP0 = 1;
	DIE = and(CTR1, CTR0);
}
