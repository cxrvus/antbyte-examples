use_cfg sp404_cfg;

set midi_out_ch_1 = 13;
set midi_out_ch_0 = 0;

set fps = 4;
set speed = 2;

set layer_limit = 2;

ant 1 {
	(A_LYR, A_ID1) = cpy(INL);

	X_OUT6 = 1;
	X_OUT0 = RND0;
	X_OUT2 = RND3;
	X_OUT3 = and (PRB1, -X_OUT2);
	X_OUT4 = PRB2;

	X_OUT11 = RND7;
	X_OUT10 = RND6;

	(COL0, COL1, COL2, COL3) = fwd(X_OUT0, X_OUT2, X_OUT3, X_OUT4);
}

ant 2 {
	X_OUT0 = EVR1;
	A_ID2 = and(X_OUT0, PRB3);
	HLT = 1;
}

ant 4 {
	(X_OUT1, X_OUT0) = cpy(EVR1);
	DIE = PRB3;
}
