use_cfg sp404_cfg;

set midi_out_ch_1 = 13;
set midi_out_ch_0 = 0;

set fps = 4;
set speed = 2;

set layer_limit = 2;

ant 1 {
	(A_LYR, A_ID_1) = cpy(INL);

	X_OUT_6 = 1;
	X_OUT_0 = RND_0;
	X_OUT_2 = RND_3;
	X_OUT_3 = and (PRB_1, -X_OUT_2);
	X_OUT_4 = PRB_2;

	X_OUT_11 = RND_7;
	X_OUT_10 = RND_6;

	(COL_0, COL_1, COL_2, COL_3) = fwd(X_OUT_0, X_OUT_2, X_OUT_3, X_OUT_4);
}

ant 2 {
	X_OUT_0 = EVR_1;
	A_ID_2 = and(X_OUT_0, PRB_3);
	HLT = 1;
}

ant 4 {
	(X_OUT_1, X_OUT_0) = cpy(EVR_1);
	DIE = PRB_3;
}
