use_cfg sp404_cfg;

set midi_out_ch_1 = 13;
set midi_out_ch_0 = 0;

set fps = 4;
set speed = 2;

set layer_limit = 2;

ant 1 {
	(AA, A1) = cpy(B);

	Y6 = 1;
	Y0 = N0;
	Y2 = N3;
	Y3 = and (P1, -Y2);
	Y4 = P2;

	Y11 = N7;
	Y10 = N6;

	(T0, T1, T2, T3) = fwd(Y0, Y2, Y3, Y4);
}

ant 2 {
	Y0 = E1;
	A2 = and(Y0, P3);
	H = 1;
}

ant 4 {
	(Y1, Y0) = cpy(E1);
	D = P3;
}
